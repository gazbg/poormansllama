+    uint64_t nv = 0;
+    const bool have_nv = ls_nvml_used_bytes(device, &nv);
+    fprintf(stderr, "vram-trace: %-34s cudaMemGetInfo in use %.1f MiB, NVML in use %.1f MiB\n", what, (double) (t - f)/1048576.0, have_nv ? (double) nv/1048576.0 : -1.0);
+    fflush(stderr);
+}
