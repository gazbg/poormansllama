+            dma_submit_max  = std::max(dma_submit_max, us);
+            if (us > 5000.0) {
+                LLAMA_LOG_WARN("moe_hybrid: slow DMA submission #%lld took %.1f ms (dma thread)\n", (long long) n_dma_engine, us/1e3);
+            }
+            dma_state.store(0, std::memory_order_release);
+            lk.lock();
+            continue;
+        }
+        if (dma_stop) {
