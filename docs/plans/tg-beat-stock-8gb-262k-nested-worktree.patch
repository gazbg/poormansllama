diff --git a/ggml/src/ggml-cuda/fattn-gqa8.cuh b/ggml/src/ggml-cuda/fattn-gqa8.cuh
new file mode 100644
index 000000000..7b5cc2b46
--- /dev/null
+++ b/ggml/src/ggml-cuda/fattn-gqa8.cuh
@@ -0,0 +1,326 @@
+#pragma once
+
+// Opt-in decode attention for one query token, head_dim 256, q8_0 K and V, 8 query heads per KV head (LLAMA_FATTN_GQA8=1).
+// The vector kernel gives each query head its own CTA, so a KV head is read and dequantized 8 times, and each key costs a warp
+// shuffle reduction per head. Here one CTA serves one KV head: QK is one thread per key (dp4a against the q8_1 Q of the 8 heads,
+// no cross-lane reduction), PV is one warp per key (lane = 8 dims, the V row is dequantized once for the 8 heads).
+// Tiles of 128 keys are dealt round-robin over gridDim.y like in the vector kernel and the partial results use the same
+// dst_tmp / meta layout, so flash_attn_combine_results finishes the job.
+
+#include "common.cuh"
+#include "fattn-common.cuh"
+
+#include <atomic>
+
+namespace fattn_gqa8 {
+
+constexpr int D    = 256;
+constexpr int NH   = 8;         // query heads per KV head
+constexpr int NW   = 4;         // warps per CTA
+constexpr int TILE = 32 * NW;   // keys per CTA iteration
+constexpr int NBLK = D / 32;    // q8_0 blocks per row
+static_assert(FATTN_KQ_STRIDE % TILE == 0, "a KV length that is a multiple of FATTN_KQ_STRIDE must hold whole tiles");
+
+static __device__ __forceinline__ int sx8(uint32_t x, int i) {   // signed byte i of x
+#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
+    return (int) (int8_t) (x >> (8 * i));
+#else
+    int r;
+    asm("bfe.s32 %0, %1, %2, 8;" : "=r"(r) : "r"(x), "r"(8 * i));
+    return r;
+#endif
+}
+
+__launch_bounds__(128, 2)
+static __global__ void kernel(
+        const char * GGML_CUDA_RESTRICT Qp, const char * GGML_CUDA_RESTRICT Kp, const char * GGML_CUDA_RESTRICT Vp, const half * GGML_CUDA_RESTRICT mask,
+        float * GGML_CUDA_RESTRICT dst, float2 * GGML_CUDA_RESTRICT dst_meta,
+        const float scale, const int N, const int nb02, const int nb11, const int nb12, const int nb21, const int nb22) {
+#ifdef FLASH_ATTN_AVAILABLE
+    const int lane  = threadIdx.x;
+    const int warp  = threadIdx.y;
+    const int tid   = warp * 32 + lane;
+    const int kvh   = blockIdx.z;
+    const int head0 = kvh * NH;
+    Kp += (size_t) kvh * nb12;
+    Vp += (size_t) kvh * nb22;
+
+    __shared__ __align__(16) int    Qq[NH * 64];
+    __shared__ __align__(16) float2 Qds[NH * 8];
+    __shared__ __align__(16) float Pw[NW][32 * NH];
+    __shared__ __align__(16) float red[NW][NH * D];
+    __shared__ float mw[NW][NH];
+    __shared__ float lw[NW][NH];
+
+    // Q to q8_1, pre-scaled, the same quantization as the vector kernel
+    for (int j = warp; j < NH; j += NW) {
+        const float * Q_f = (const float *) (Qp + (size_t) (head0 + j) * nb02);
+#pragma unroll
+        for (int i0 = 0; i0 < D / (int) sizeof(int); i0 += 32) {
+            quantize_q8_1_to_shared<float2, 32>(Q_f + i0 * sizeof(int), scale, Qq + j * 64 + i0, Qds + j * 8 + i0 / QI8_1);
+        }
+    }
+    __syncthreads();
+
+    float m[NH], l[NH], acc[NH][8];
+#pragma unroll
+    for (int h = 0; h < NH; ++h) {
+        m[h] = -FLT_MAX / 2.0f;
+        l[h] = 0.0f;
+#pragma unroll
+        for (int i = 0; i < 8; ++i) acc[h][i] = 0.0f;
+    }
+
+    const int blk  = lane >> 2;                      // q8_0 block of this lane's 8 dims in the PV stage
+    const int voff = 34 * blk + 2 + 8 * (lane & 3);  // byte offset of those 8 int8 values inside a row
+    const int vwa  = voff & ~3;
+    const int vsh  = (voff & 3) * 8;                 // 16 for even blocks, 0 for odd blocks
+
+    for (int k0 = blockIdx.y * TILE; k0 < N; k0 += gridDim.y * TILE) {
+        const int key = k0 + warp * 32 + lane;
+
+        // QK: one thread per key, the row (272 B) is read once as 17 x 16 B
+        uint32_t w[68];
+        {
+            const uint4 * rowp = (const uint4 *) (Kp + (size_t) key * nb11);
+#pragma unroll
+            for (int g = 0; g < 17; ++g) {
+                const uint4 v = rowp[g];
+                w[4 * g + 0] = v.x; w[4 * g + 1] = v.y; w[4 * g + 2] = v.z; w[4 * g + 3] = v.w;
+            }
+        }
+        float S[NH];
+#pragma unroll
+        for (int h = 0; h < NH; ++h) S[h] = 0.0f;
+#pragma unroll
+        for (int b = 0; b < NBLK; ++b) {
+            const int mm = b >> 1;   // blocks are 34 B: even blocks start 2 B into a word, odd blocks are word aligned
+            int kq[8];
+            float dK;
+            if ((b & 1) == 0) {
+                dK = __half2float(__ushort_as_half((unsigned short) (w[17 * mm] & 0xFFFFu)));
+#pragma unroll
+                for (int j = 0; j < 8; ++j) kq[j] = (int) __funnelshift_r(w[17 * mm + j], w[17 * mm + j + 1], 16);
+            } else {
+                dK = __half2float(__ushort_as_half((unsigned short) (w[17 * mm + 8] >> 16)));
+#pragma unroll
+                for (int j = 0; j < 8; ++j) kq[j] = (int) w[17 * mm + 9 + j];
+            }
+#pragma unroll
+            for (int h = 0; h < NH; ++h) {
+                const int4 q0 = *(const int4 *) &Qq[h * 64 + b * 8];
+                const int4 q1 = *(const int4 *) &Qq[h * 64 + b * 8 + 4];
+                int s = 0;
+                s = ggml_cuda_dp4a(kq[0], q0.x, s);
+                s = ggml_cuda_dp4a(kq[1], q0.y, s);
+                s = ggml_cuda_dp4a(kq[2], q0.z, s);
+                s = ggml_cuda_dp4a(kq[3], q0.w, s);
+                s = ggml_cuda_dp4a(kq[4], q1.x, s);
+                s = ggml_cuda_dp4a(kq[5], q1.y, s);
+                s = ggml_cuda_dp4a(kq[6], q1.z, s);
+                s = ggml_cuda_dp4a(kq[7], q1.w, s);
+                S[h] += (float) s * (dK * Qds[h * 8 + b].x);
+            }
+        }
+        const float mk = __half2float(mask[key]);
+#pragma unroll
+        for (int h = 0; h < NH; ++h) S[h] += mk;
+
+        // online softmax over the 32 keys of this warp's tile
+        float p[NH];
+#pragma unroll
+        for (int h = 0; h < NH; ++h) {
+            const float tmax  = warp_reduce_max<WARP_SIZE>(S[h]);
+            const float m_new = fmaxf(m[h], tmax);
+            const float sc    = expf(m[h] - m_new);
+            m[h] = m_new;
+            p[h] = expf(S[h] - m_new);
+            l[h] = l[h] * sc + p[h];
+#pragma unroll
+            for (int i = 0; i < 8; ++i) acc[h][i] *= sc;
+        }
+        *(float4 *) &Pw[warp][lane * 8]     = make_float4(p[0], p[1], p[2], p[3]);
+        *(float4 *) &Pw[warp][lane * 8 + 4] = make_float4(p[4], p[5], p[6], p[7]);
+        __syncwarp();
+
+        // PV: one key at a time per warp, lane = 8 consecutive dims
+        const char * Vt = Vp + (size_t) (k0 + warp * 32) * nb21;
+#pragma unroll 4
+        for (int kk = 0; kk < 32; ++kk) {
+            const char * vr = Vt + (size_t) kk * nb21;
+            const float4 pa = *(const float4 *) &Pw[warp][kk * 8];
+            const float4 pb = *(const float4 *) &Pw[warp][kk * 8 + 4];
+            const float  dv = __half2float(*(const half *) (vr + 34 * blk));
+            const uint32_t v0 = *(const uint32_t *) (vr + vwa);
+            const uint32_t v1 = *(const uint32_t *) (vr + vwa + 4);
+            const uint32_t v2 = vsh ? *(const uint32_t *) (vr + vwa + 8) : 0u;
+            const uint32_t lo = vsh ? __funnelshift_r(v0, v1, 16) : v0;
+            const uint32_t hi = vsh ? __funnelshift_r(v1, v2, 16) : v1;
+            float qf[8];
+            qf[0] = (float) sx8(lo, 0); qf[1] = (float) sx8(lo, 1); qf[2] = (float) sx8(lo, 2); qf[3] = (float) sx8(lo, 3);
+            qf[4] = (float) sx8(hi, 0); qf[5] = (float) sx8(hi, 1); qf[6] = (float) sx8(hi, 2); qf[7] = (float) sx8(hi, 3);
+            const float pd[NH] = {pa.x * dv, pa.y * dv, pa.z * dv, pa.w * dv, pb.x * dv, pb.y * dv, pb.z * dv, pb.w * dv};
+#pragma unroll
+            for (int h = 0; h < NH; ++h) {
+#pragma unroll
+                for (int i = 0; i < 8; ++i) acc[h][i] = fmaf(pd[h], qf[i], acc[h][i]);
+            }
+        }
+        __syncwarp();
+    }
+
+    // merge the 4 warps, write the CTA's partial result (normalized when this is the only CTA of the head)
+    float lsum[NH];
+#pragma unroll
+    for (int h = 0; h < NH; ++h) lsum[h] = warp_reduce_sum<WARP_SIZE>(l[h]);
+    if (lane == 0) {
+#pragma unroll
+        for (int h = 0; h < NH; ++h) { mw[warp][h] = m[h]; lw[warp][h] = lsum[h]; }
+    }
+#pragma unroll
+    for (int h = 0; h < NH; ++h) {
+        *(float4 *) &red[warp][h * D + lane * 8]     = make_float4(acc[h][0], acc[h][1], acc[h][2], acc[h][3]);
+        *(float4 *) &red[warp][h * D + lane * 8 + 4] = make_float4(acc[h][4], acc[h][5], acc[h][6], acc[h][7]);
+    }
+    __syncthreads();
+#pragma unroll
+    for (int h = 0; h < NH; ++h) {
+        float mt = mw[0][h];
+#pragma unroll
+        for (int ww = 1; ww < NW; ++ww) mt = fmaxf(mt, mw[ww][h]);
+        float st = 0.0f, o0 = 0.0f, o1 = 0.0f;
+#pragma unroll
+        for (int ww = 0; ww < NW; ++ww) {
+            const float f = expf(mw[ww][h] - mt);
+            st += lw[ww][h] * f;
+            o0 += red[ww][h * D + 2 * tid] * f;
+            o1 += red[ww][h * D + 2 * tid + 1] * f;
+        }
+        if (gridDim.y == 1) { o0 /= st; o1 /= st; }
+        *(float2 *) &dst[((size_t) (head0 + h) * gridDim.y + blockIdx.y) * D + 2 * tid] = make_float2(o0, o1);
+        if (tid == 0) dst_meta[(size_t) (head0 + h) * gridDim.y + blockIdx.y] = make_float2(mt, st);
+    }
+#else
+    GGML_UNUSED_VARS(Qp, Kp, Vp, mask, dst, dst_meta, scale, N, nb02, nb11, nb12, nb21, nb22);
+    NO_DEVICE_CODE;
+#endif // FLASH_ATTN_AVAILABLE
+}
+
+} // namespace fattn_gqa8
+
+static bool ggml_cuda_fattn_gqa8_enabled() {
+    static const bool on = []() {
+        const char * e = getenv("LLAMA_FATTN_GQA8");
+        return e != nullptr && atoi(e) != 0;
+    }();
+    return on;
+}
+
+// Below this KV length the vector kernel is as fast or faster (measured: equal at 768 keys, 1.5x slower at 256); LLAMA_FATTN_GQA8_MIN_KV overrides.
+static int ggml_cuda_fattn_gqa8_min_kv() {
+    static const int v = []() {
+        const char * e = getenv("LLAMA_FATTN_GQA8_MIN_KV");
+        return e != nullptr ? atoi(e) : 2048;
+    }();
+    return v;
+}
+
+// Blocks per SM for the kernel, queried once per device. The first query loads the kernel module, so applies() makes it on the first flash-attention op of any
+// size and not in the middle of a decode (a driver call on the launching thread while the hybrid engine's GPU kernels spin is the deadlock of G5).
+static int ggml_cuda_fattn_gqa8_occupancy(const int device) {
+    static std::atomic<int> occ[GGML_CUDA_MAX_DEVICES];
+    int o = occ[device].load(std::memory_order_relaxed);
+    if (o == 0) {
+        CUDA_CHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&o, fattn_gqa8::kernel, 128, 0));
+        o = std::max(o, 1);
+        occ[device].store(o, std::memory_order_relaxed);
+    }
+    return o;
+}
+
+// Shapes this kernel serves: one token, one sequence, head_dim 256, q8_0 K and V, 8 query heads per KV head, an f16 mask, no sinks, no alibi, no softcap.
+static bool ggml_cuda_fattn_gqa8_applies(const ggml_tensor * dst) {
+    if (!ggml_cuda_fattn_gqa8_enabled()) {
+        return false;
+    }
+    (void) ggml_cuda_fattn_gqa8_occupancy(ggml_cuda_get_device());
+    if (dst->src[1]->ne[1] < ggml_cuda_fattn_gqa8_min_kv()) {
+        return false;
+    }
+    const ggml_tensor * Q = dst->src[0];
+    const ggml_tensor * K = dst->src[1];
+    const ggml_tensor * V = dst->src[2];
+    const ggml_tensor * mask  = dst->src[3];
+    const ggml_tensor * sinks = dst->src[4];
+    float max_bias = 0.0f, softcap = 0.0f;
+    memcpy(&max_bias, (const float *) dst->op_params + 1, sizeof(float));
+    memcpy(&softcap,  (const float *) dst->op_params + 2, sizeof(float));
+    return sinks == nullptr && mask != nullptr && max_bias == 0.0f && softcap == 0.0f &&
+        Q->type == GGML_TYPE_F32 && K->type == GGML_TYPE_Q8_0 && V->type == GGML_TYPE_Q8_0 && mask->type == GGML_TYPE_F16 &&
+        Q->ne[0] == fattn_gqa8::D && K->ne[0] == fattn_gqa8::D && V->ne[0] == fattn_gqa8::D &&
+        Q->ne[1] == 1 && Q->ne[3] == 1 && K->ne[3] == 1 && V->ne[3] == 1 && mask->ne[2] == 1 && mask->ne[3] == 1 &&
+        K->ne[2] >= 1 && Q->ne[2] == fattn_gqa8::NH * K->ne[2] && V->ne[2] == K->ne[2] &&
+        K->ne[1] > 0 && K->ne[1] % FATTN_KQ_STRIDE == 0 && V->ne[1] == K->ne[1] && mask->ne[0] >= K->ne[1] &&
+        Q->nb[0] == sizeof(float) && Q->nb[2] % sizeof(float) == 0 && (uintptr_t) Q->data % sizeof(float) == 0 &&
+        K->nb[0] == sizeof(block_q8_0) && V->nb[0] == sizeof(block_q8_0) &&
+        mask->nb[0] == sizeof(ggml_fp16_t) && dst->nb[0] == sizeof(float) && dst->nb[1] == fattn_gqa8::D * sizeof(float) &&
+        K->nb[1] % 16 == 0 && K->nb[2] % 16 == 0 && V->nb[1] % 16 == 0 && V->nb[2] % 16 == 0 &&
+        (uintptr_t) K->data % 16 == 0 && (uintptr_t) V->data % 16 == 0;
+}
+
+// Same wave-efficiency search as launch_fattn() uses for the vector kernel, with one tile row per KV head.
+static int ggml_cuda_fattn_gqa8_parallel_blocks(const int N, const int nkv, const int nsm, const int occ) {
+    const int ntiles_KV = N / fattn_gqa8::TILE;
+    const int blocks_per_wave = nsm * occ;
+    int pb = std::min(occ, ntiles_KV), nwaves_best = 0, eff_best = 0;
+    for (int pbt = pb; pbt <= ntiles_KV; ++pbt) {
+        const int nblocks_total = nkv * pbt;
+        const int nwaves = (nblocks_total + blocks_per_wave - 1) / blocks_per_wave;
+        const int eff = 100 * nblocks_total / (nwaves * blocks_per_wave);
+        if (eff_best >= 95 && nwaves > nwaves_best) {
+            break;
+        }
+        if (eff > eff_best) {
+            nwaves_best = nwaves;
+            eff_best = eff;
+            pb = pbt;
+        }
+    }
+    return pb;
+}
+
+// scale is the op's own softmax scale (op_params[0]), applied to Q before it is quantized, like launch_fattn() does
+static void ggml_cuda_fattn_gqa8_launch(const char * Q, const int nb02, const char * K, const int nb11, const int nb12, const char * V, const int nb21, const int nb22,
+        const half * mask, float * dst, float * dst_tmp, float2 * dst_meta, const int N, const int nkv, const int pb, const float scale, cudaStream_t stream) {
+    fattn_gqa8::kernel<<<dim3(1, pb, nkv), dim3(32, fattn_gqa8::NW, 1), 0, stream>>>(
+        Q, K, V, mask, pb > 1 ? dst_tmp : dst, dst_meta, scale, N, nb02, nb11, nb12, nb21, nb22);
+    CUDA_CHECK(cudaGetLastError());
+    if (pb > 1) {
+        flash_attn_combine_results<fattn_gqa8::D><<<dim3(1, nkv * fattn_gqa8::NH, 1), dim3(fattn_gqa8::D, 1, 1), pb * sizeof(float2), stream>>>(dst_tmp, dst_meta, dst, pb);
+        CUDA_CHECK(cudaGetLastError());
+    }
+}
+
+static void ggml_cuda_flash_attn_ext_gqa8(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    const ggml_tensor * Q = dst->src[0];
+    const ggml_tensor * K = dst->src[1];
+    const ggml_tensor * V = dst->src[2];
+    const ggml_tensor * mask = dst->src[3];
+
+    float scale = 1.0f;
+    memcpy(&scale, (const float *) dst->op_params + 0, sizeof(float));
+
+    const int N   = (int) K->ne[1];
+    const int nkv = (int) K->ne[2];
+    const int pb  = ggml_cuda_fattn_gqa8_parallel_blocks(N, nkv, ggml_cuda_info().devices[ctx.device].nsm, ggml_cuda_fattn_gqa8_occupancy(ctx.device));
+
+    // the pool is a stack: allocate in declaration order so that the destructors free in reverse
+    ggml_cuda_pool_alloc<float>  dst_tmp(ctx.pool());
+    ggml_cuda_pool_alloc<float2> dst_meta(ctx.pool());
+    if (pb > 1) {
+        dst_tmp.alloc((size_t) pb * ggml_nelements(dst));
+    }
+    dst_meta.alloc((size_t) pb * ggml_nrows(dst));
+    ggml_cuda_fattn_gqa8_launch((const char *) Q->data, (int) Q->nb[2], (const char *) K->data, (int) K->nb[1], (int) K->nb[2],
+        (const char *) V->data, (int) V->nb[1], (int) V->nb[2], (const half *) mask->data, (float *) dst->data, dst_tmp.ptr, dst_meta.ptr, N, nkv, pb, scale, ctx.stream());
+}
diff --git a/src/llama-moe-lean.h b/src/llama-moe-lean.h
new file mode 100644
index 000000000..2b371714c
--- /dev/null
+++ b/src/llama-moe-lean.h
@@ -0,0 +1,649 @@
+#pragma once
+
+// G14: a lean host leg for the hybrid MoE decode. The host serves the experts that missed the VRAM cache. The graph that did this (three mul_mat_id, a swiglu, a multiply and a
+// chain of adds, 8-12 nodes) measured 33 us of fixed cost per request on top of 43 us per expert (the DRAM-bound part), because every node ends in a thread-pool barrier and
+// every mul_mat_id rebuilds its row mapping over all 256 experts. This file computes the same result with the same vec_dot kernels, quantizers and swiglu routine the graph calls
+// (so the output is bit-identical, which tests/test-moe-lean-expert.cpp checks), in ONE parallel region with three spin barriers:
+//   A  quantize the input row to the dot-product type (each thread its blocks)          barrier
+//   B  up and gate dot products, each thread its slice of rows, for every missed expert barrier
+//   C  every thread: swiglu of the full [m][n_ff] and the quantization of the result (redundant on purpose: ~1 us, cheaper than a barrier)
+//   D  down dot products for the thread's slice of output rows, the router weights and the sum over the experts, written straight into y     barrier
+// The summation order is the graph's: out = ((e0*w0 + e1*w1) + e2*w2) + ..., each product and each sum rounded to float (the products are stored before the sums so that no compiler
+// can contract a multiply and the following add into one fused operation: the graph rounds between them, because they are separate ops).
+//
+// G15: an optional stage after the reply (`team::post`). The engine has just answered the request of layer l-1 and the GPU still needs ~90 us before it posts layer l's: the workers
+// spin through it. They use it to predict layer l's misses from the request's input row (the router of layer l on the FFN input of layer l-1, rows in q8_0, one barrier), take the
+// first K experts of the predicted top ranks that are not resident and PREFETCH their own row slices of those experts (the same slices B and D read) into their caches, so that the
+// request of layer l reads the experts that were predicted right from the cache instead of from DRAM. A prefetch only touches memory: it cannot change a result.
+//
+// Header only; depends on ggml.h / ggml-cpu.h. `team` owns the worker threads (the caller of run() is thread 0).
+
+#include "ggml.h"
+#include "ggml-cpu.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#if defined(_M_X64) || defined(__x86_64__)
+#include <emmintrin.h>
+#if defined(_MSC_VER)
+#include <intrin.h>
+#else
+#include <x86intrin.h>
+#endif
+#define MOE_LEAN_PAUSE() _mm_pause()
+#else
+#define MOE_LEAN_PAUSE() std::this_thread::yield()
+#endif
+
+namespace moe_lean {
+
+// time stamp counter and the logical CPU the thread runs on (IA32_TSC_AUX holds the processor number on Windows and Linux), for the stall diagnostic
+inline uint64_t tsc_now(unsigned * cpu) {
+#if defined(_M_X64) || defined(__x86_64__)
+    unsigned       aux = 0;
+    const uint64_t t   = __rdtscp(&aux);
+    if (cpu) { *cpu = aux & 0xFFFu; }
+    return t;
+#else
+    if (cpu) { *cpu = 0; }
+    return (uint64_t) std::chrono::steady_clock::now().time_since_epoch().count();
+#endif
+}
+
+constexpr int MAX_M  = 8; // experts per request (n_expert_used)
+constexpr int MAX_PF = 4; // experts prefetched per request
+
+// one routed-expert bank of a layer: ne = [k, rows, n_expert], plain contiguous host memory
+struct bank {
+    const char * data         = nullptr;
+    size_t       row_bytes    = 0; // nb[1]
+    size_t       expert_bytes = 0; // nb[2]
+    ggml_type    type         = GGML_TYPE_F32;
+    int64_t      k = 0, rows = 0;
+};
+
+inline bank bank_of(const ggml_tensor * t) {
+    bank b;
+    b.data         = (const char *) t->data;
+    b.row_bytes    = t->nb[1];
+    b.expert_bytes = t->nb[2];
+    b.type         = t->type;
+    b.k            = t->ne[0];
+    b.rows         = t->ne[1];
+    return b;
+}
+
+struct layer_banks {
+    bank up, gate, down;
+};
+
+struct job {
+    const layer_banks * lb  = nullptr;
+    int                 m   = 0;
+    const int32_t *     ids = nullptr; // [m]
+    const float *       w   = nullptr; // [m]
+    const float *       x   = nullptr; // [n_embd]
+    float *             y   = nullptr; // [n_embd]
+
+    // G15 (optional): after the reply, predict the NEXT layer's misses from this row and prefetch them. pf_lb == nullptr or pf_k == 0 = no such stage.
+    const layer_banks * pf_lb    = nullptr; // banks of the next layer
+    const char *        pf_rw    = nullptr; // router of the next layer, q8_0 rows [n_expert][row_size(q8_0, n_embd)]
+    const int32_t *     pf_map   = nullptr; // slot per expert of the next layer, < 0 = not resident (read racily: a stale value only changes which experts are prefetched)
+    int                 pf_k     = 0;       // experts to prefetch (<= MAX_PF)
+    int                 pf_pool  = 12;      // candidates come from the predictor's top-pool ranks
+    int                 pf_hint  = 1;       // 0 prefetcht0, 1 prefetcht1 (L2), 2 prefetcht2, 3 prefetchnta, 4 plain loads of every line (a prefetch instruction can be dropped when the core's
+                                            // miss buffers are full; a load waits for them, so the stream of one thread runs at that thread's bandwidth)
+    const int32_t *     pf_force = nullptr; // tests: prefetch exactly these pf_k experts, no prediction
+    bool              (*pf_abort)(void *) = nullptr; // called every 128 lines by every thread: true = stop the prefetch (the engine says: another request is waiting)
+    void *              pf_abort_ctx = nullptr;
+};
+
+// the shapes the lean path computes; anything else must go through the graph
+inline bool supported(const layer_banks & lb) {
+    const ggml_type_traits_cpu * tu = ggml_get_type_traits_cpu(lb.up.type);
+    const ggml_type_traits_cpu * tg = ggml_get_type_traits_cpu(lb.gate.type);
+    const ggml_type_traits_cpu * td = ggml_get_type_traits_cpu(lb.down.type);
+    if (!tu || !tg || !td || !tu->vec_dot || !tg->vec_dot || !td->vec_dot) {
+        return false;
+    }
+    if (tu->vec_dot_type != tg->vec_dot_type || tu->nrows != 1 || tg->nrows != 1 || td->nrows != 1) {
+        return false;
+    }
+    const ggml_type_traits_cpu * qx = ggml_get_type_traits_cpu(tu->vec_dot_type);
+    const ggml_type_traits_cpu * qa = ggml_get_type_traits_cpu(td->vec_dot_type);
+    if (!qx || !qa || !qx->from_float || !qa->from_float) {
+        return false;
+    }
+    if (lb.up.type != lb.gate.type || lb.up.row_bytes != lb.gate.row_bytes || lb.up.expert_bytes != lb.gate.expert_bytes) {
+        return false;
+    }
+    return lb.up.k == lb.gate.k && lb.up.rows == lb.gate.rows && lb.down.k == lb.up.rows && lb.up.k % ggml_blck_size(tu->vec_dot_type) == 0 &&
+           lb.down.k % ggml_blck_size(td->vec_dot_type) == 0 && lb.down.rows == lb.up.k;
+}
+
+// q8_0 copy of a router matrix given as float rows [n_expert][n_embd] (n_embd must be a multiple of 32): the predictor's weights, 8.5 bits per weight
+inline std::vector<char> quantize_router_q8(const float * rows, int64_t n_expert, int64_t n_embd) {
+    const ggml_type_traits_cpu * t8 = ggml_get_type_traits_cpu(GGML_TYPE_Q8_0);
+    const size_t                 rr = ggml_row_size(GGML_TYPE_Q8_0, n_embd);
+    std::vector<char>            out((size_t) n_expert*rr);
+    for (int64_t e = 0; e < n_expert; ++e) {
+        t8->from_float(rows + (size_t) e*n_embd, out.data() + (size_t) e*rr, n_embd);
+    }
+    return out;
+}
+
+// sense-reversing spin barrier
+struct barrier {
+    alignas(64) std::atomic<int> count{0};
+    alignas(64) std::atomic<int> sense{0};
+    int n = 1;
+
+    void wait(int & local_sense) {
+        local_sense ^= 1;
+        if (count.fetch_add(1, std::memory_order_acq_rel) == n - 1) {
+            count.store(0, std::memory_order_relaxed);
+            sense.store(local_sense, std::memory_order_release);
+        } else {
+            while (sense.load(std::memory_order_acquire) != local_sense) {
+                MOE_LEAN_PAUSE();
+            }
+        }
+    }
+};
+
+// a 64-byte aligned scratch buffer
+struct abuf {
+    std::vector<char> v;
+    char *            p = nullptr;
+
+    void alloc(size_t n) {
+        v.assign(n + 64, 0);
+        p = (char *) (((uintptr_t) v.data() + 63) & ~(uintptr_t) 63);
+    }
+};
+
+// stage times as thread 0 sees them (each includes the wait for the slowest thread at the barrier that ends the stage)
+struct stage_stats {
+    double  a_us = 0.0, b_us = 0.0, c_us = 0.0, d_us = 0.0;
+    int64_t n = 0;
+    double  post_us = 0.0; // the post stage (logits, barrier, selection, prefetch issue), thread 0's view
+    int64_t n_post = 0;
+};
+
+// the experts the last post stage chose (thread 0's copy)
+struct pf_choice {
+    int     n = 0;
+    int32_t ids[MAX_PF] = {};
+};
+
+class team {
+public:
+    // `n_expert` > 0 and a multiple-of-32 `n_embd` enable the G15 post stage. `on_worker_start(ith)` runs on worker thread ith (1 .. n_threads-1) before its first job (pinning,
+    // priority); `spin_us` is how long an idle worker spins before it parks
+    team(int n_threads, int64_t n_embd, int64_t n_ff, int64_t n_expert = 0, std::function<void(int)> on_worker_start = nullptr, int spin_us = 4000, bool profile = false) :
+        nth_(std::max(1, n_threads)), spin_us_(spin_us), profile_(profile), n_embd_(n_embd), n_expert_(n_expert), on_start_(std::move(on_worker_start)) {
+        bar_.n = nth_;
+        xq_.alloc((size_t) 4*n_embd + 64);               // up to 4 bytes per element (f32 activations)
+        xf_.assign((size_t) n_embd, 0.0f);
+        up_.assign((size_t) MAX_M*n_ff, 0.0f);
+        gate_.assign((size_t) MAX_M*n_ff, 0.0f);
+        logit_.assign((size_t) std::max<int64_t>(n_expert, 1), 0.0f);
+        tc_.resize((size_t) nth_);
+        for (auto & t : tc_) {
+            t.act.assign((size_t) MAX_M*n_ff, 0.0f);
+            t.actq.alloc((size_t) MAX_M*(4*n_ff + 64));
+            t.ex.assign((size_t) MAX_M*(n_embd/nth_ + 2), 0.0f);
+            if (n_expert > 0 && n_embd % 32 == 0) {
+                t.xq8.alloc(ggml_row_size(GGML_TYPE_Q8_0, n_embd) + 64);
+            }
+        }
+        arr_.resize((size_t) nth_);
+        {
+            // ticks of the time stamp counter per microsecond, from the steady clock
+            const auto     t0 = clk::now();
+            const uint64_t c0 = tsc_now(nullptr);
+            while (since_us(t0) < 2000.0) { MOE_LEAN_PAUSE(); }
+            const uint64_t c1 = tsc_now(nullptr);
+            tpu_ = std::max(1.0, (double) (c1 - c0)/since_us(t0));
+        }
+        for (int i = 1; i < nth_; ++i) {
+            workers_.emplace_back([this, i] { worker_main(i); });
+        }
+        // no job may be published before every worker is up: a worker that read job_seq_ after the first publish would wait for a job that already started
+        while (ready_.load(std::memory_order_acquire) < nth_ - 1) {
+            std::this_thread::yield();
+        }
+    }
+
+    ~team() { stop(); }
+
+    team(const team &) = delete;
+    team & operator=(const team &) = delete;
+
+    int n_threads() const { return nth_; }
+
+    // joins the workers (idempotent); no run() may be in flight
+    void stop() {
+        if (stop_.exchange(true)) {
+            return;
+        }
+        { std::lock_guard<std::mutex> lk(mtx_); }
+        cv_.notify_all();
+        for (auto & t : workers_) {
+            if (t.joinable()) {
+                t.join();
+            }
+        }
+        workers_.clear();
+    }
+
+    // thread 0: publish the job, run its share, return when every thread has passed the last barrier (y is complete). If the job asks for the post stage the caller must call post()
+    // before its next run() (run() settles an unanswered post as "skip" itself, so the workers never wait for a decision that does not come).
+    void run(const job & j) {
+        if (pending_post_) {
+            post(false);
+        }
+        const bool want_post = j.pf_lb != nullptr && j.pf_k > 0 && (j.pf_force != nullptr || (j.pf_rw != nullptr && j.pf_map != nullptr && n_expert_ > 0 && !tc_[0].xq8.v.empty()));
+        cur_ = j;
+        if (!want_post) {
+            cur_.pf_lb = nullptr;       // the workers copy this job: they must not wait for a post stage that is not coming
+            cur_.pf_k  = 0;
+        }
+        pending_post_ = want_post;
+        cur_seq_      = job_seq_.load(std::memory_order_relaxed) + 1;
+        ++req_no_;
+        t_pub_        = tsc_now(nullptr);
+        arr_[0].t_in  = t_pub_;
+        job_seq_.fetch_add(1, std::memory_order_seq_cst);
+        if (parked_.load(std::memory_order_seq_cst) > 0) {
+            { std::lock_guard<std::mutex> lk(mtx_); }
+            cv_.notify_all();
+        }
+        execute(0, cur_, tc_[0]);
+    }
+
+    // thread 0, after it has answered the request: go = true runs the post stage together with the workers (they wait for this call); go = false tells them to skip it
+    // (another request is already pending: it must not wait behind a prefetch). Returns true when a post stage ran.
+    bool post(bool go) {
+        if (!pending_post_) {
+            return false;
+        }
+        pending_post_ = false;
+        post_state_.store(((uint64_t) cur_seq_ << 2) | (go ? 1u : 2u), std::memory_order_seq_cst);
+        if (go) {
+            const auto t0 = profile_ ? clk::now() : clk::time_point();
+            post_stage(0, tc_[0], cur_, cur_seq_);
+            if (profile_) {
+                stats_.post_us += since_us(t0);
+                stats_.n_post++;
+            }
+        }
+        return go;
+    }
+
+    // a request that takes longer than `us` microseconds is described by `fn` (which thread arrived last at which barrier, on which CPU, and how late each thread picked the job up)
+    void set_stall_logger(double us, std::function<void(const char *)> fn) {
+        stall_us_ = us;
+        on_stall_ = std::move(fn);
+    }
+
+    const pf_choice & last_choice() const { return choice_; }
+    const stage_stats & stats() const { return stats_; }
+
+private:
+    struct tctx {
+        std::vector<float> act;
+        abuf               actq;
+        std::vector<float> ex;
+        abuf               xq8;   // the request row in q8_0, for the router dot products of the post stage
+        int                ls = 0;
+    };
+
+    using clk = std::chrono::steady_clock;
+
+    static double since_us(clk::time_point t) { return std::chrono::duration<double, std::micro>(clk::now() - t).count(); }
+
+    void park(uint32_t seen) {
+        std::unique_lock<std::mutex> lk(mtx_);
+        parked_.fetch_add(1, std::memory_order_seq_cst);
+        cv_.wait(lk, [&] { return stop_.load(std::memory_order_seq_cst) || job_seq_.load(std::memory_order_seq_cst) != seen; });
+        parked_.fetch_sub(1, std::memory_order_seq_cst);
+    }
+
+    void worker_main(int ith) {
+        if (on_start_) {
+            on_start_(ith);
+        }
+        uint32_t seen = 0; // job_seq_ starts at 0 and the constructor does not return before this thread has announced itself
+        ready_.fetch_add(1, std::memory_order_release);
+        for (;;) {
+            uint32_t cur   = seen;
+            uint32_t spins = 0;
+            auto     t0    = clk::now();
+            for (;;) {
+                cur = job_seq_.load(std::memory_order_acquire);
+                if (cur != seen || stop_.load(std::memory_order_relaxed)) {
+                    break;
+                }
+                MOE_LEAN_PAUSE();
+                if ((++spins & 1023) == 0 && since_us(t0) > spin_us_) {
+                    park(seen);
+                    t0 = clk::now();
+                }
+            }
+            if (cur == seen) {
+                return; // stop
+            }
+            seen = cur;
+            arr_[(size_t) ith].t_in = tsc_now(nullptr);
+            const job jl = cur_;                 // a private copy: the leader may publish the next job while a slow worker is still in the post stage
+            execute(ith, jl, tc_[(size_t) ith]);
+            if (jl.pf_lb != nullptr && jl.pf_k > 0) {
+                // wait for the leader's decision on the post stage of THIS job (the tag is the job's sequence number)
+                uint64_t v;
+                for (;;) {
+                    v = post_state_.load(std::memory_order_acquire);
+                    if ((uint32_t) (v >> 2) == cur) {
+                        break;
+                    }
+                    if (stop_.load(std::memory_order_relaxed)) {
+                        return;
+                    }
+                    MOE_LEAN_PAUSE();
+                }
+                if ((v & 3) == 1) {
+                    post_stage(ith, tc_[(size_t) ith], jl, cur);
+                }
+            }
+        }
+    }
+
+    template <int HINT>
+    static inline bool pf_span(const char * b, const char * e, const std::atomic<uint32_t> & seq_now, uint32_t seq, bool (*abort_fn)(void *), void * abort_ctx) {
+        int cnt = 0;
+        for (const char * p = (const char *) ((uintptr_t) b & ~(uintptr_t) 63); p < e; p += 64) {
+            if (HINT == 4) {
+                (void) *(const volatile unsigned char *) p;
+            } else {
+#if defined(_M_X64) || defined(__x86_64__)
+                _mm_prefetch(p, HINT == 0 ? _MM_HINT_T0 : HINT == 1 ? _MM_HINT_T1 : HINT == 2 ? _MM_HINT_T2 : _MM_HINT_NTA);
+#else
+                __builtin_prefetch(p);
+#endif
+            }
+            if ((++cnt & 127) == 0 && (seq_now.load(std::memory_order_relaxed) != seq || (abort_fn != nullptr && abort_fn(abort_ctx)))) {
+                return false;       // the next request has been published (or is waiting): the rest of the prefetch would only get in its way
+            }
+        }
+        return true;
+    }
+
+    // the post stage, run by every thread after the reply: logits of this thread's experts -> barrier -> the same top ranks everywhere -> prefetch this thread's slices
+    void post_stage(int ith, tctx & tc, const job & j, uint32_t seq) {
+        int       sel[MAX_PF];
+        int       nsel = 0;
+        const int K    = std::min(j.pf_k, (int) MAX_PF);
+        if (j.pf_force != nullptr) {
+            for (int i = 0; i < K; ++i) {
+                sel[nsel++] = j.pf_force[i];
+            }
+        } else {
+            const ggml_type_traits_cpu * t8   = ggml_get_type_traits_cpu(GGML_TYPE_Q8_0);
+            const size_t                 rrow = ggml_row_size(GGML_TYPE_Q8_0, n_embd_);
+            t8->from_float(xf_.data(), (void *) tc.xq8.p, n_embd_);
+            const int64_t e0 = (ith*n_expert_)/nth_;
+            const int64_t e1 = ((ith + 1)*n_expert_)/nth_;
+            for (int64_t e = e0; e < e1; ++e) {
+                t8->vec_dot((int) n_embd_, &logit_[(size_t) e], 0, j.pf_rw + (size_t) e*rrow, 0, tc.xq8.p, 0, 1);
+            }
+            bar_.wait(tc.ls);
+            // top ranks, ties to the lower expert id; every thread computes the same list from the same logits
+            const int pool = std::min(std::max(j.pf_pool, K), 16);
+            float     tv[16];
+            int       ti[16];
+            int       n = 0;
+            for (int64_t e = 0; e < n_expert_; ++e) {
+                const float v = logit_[(size_t) e];
+                if (n == pool && !(v > tv[pool - 1])) {
+                    continue;
+                }
+                int p = n < pool ? n : pool - 1;
+                while (p > 0 && v > tv[p - 1]) {
+                    tv[p] = tv[p - 1];
+                    ti[p] = ti[p - 1];
+                    --p;
+                }
+                tv[p] = v;
+                ti[p] = (int) e;
+                if (n < pool) {
+                    ++n;
+                }
+            }
+            for (int r = 0; r < n && nsel < K; ++r) {
+                if (j.pf_map[ti[r]] < 0) {
+                    sel[nsel++] = ti[r];
+                }
+            }
+        }
+        if (ith == 0) {
+            choice_.n = nsel;
+            for (int i = 0; i < nsel; ++i) {
+                choice_.ids[i] = sel[i];
+            }
+        }
+        const layer_banks & nb    = *j.pf_lb;
+        const int64_t       n_ff  = nb.up.rows;
+        const int64_t       n_out = nb.down.rows;
+        const int64_t       r0 = (ith*n_ff)/nth_, r1 = ((ith + 1)*n_ff)/nth_;
+        const int64_t       d0 = (ith*n_out)/nth_, d1 = ((ith + 1)*n_out)/nth_;
+        for (int s = 0; s < nsel; ++s) {
+            const size_t e = (size_t) sel[s];
+            const char * spans[3][2] = {
+                { nb.up.data   + e*nb.up.expert_bytes   + (size_t) r0*nb.up.row_bytes,   nb.up.data   + e*nb.up.expert_bytes   + (size_t) r1*nb.up.row_bytes   },
+                { nb.gate.data + e*nb.gate.expert_bytes + (size_t) r0*nb.gate.row_bytes, nb.gate.data + e*nb.gate.expert_bytes + (size_t) r1*nb.gate.row_bytes },
+                { nb.down.data + e*nb.down.expert_bytes + (size_t) d0*nb.down.row_bytes, nb.down.data + e*nb.down.expert_bytes + (size_t) d1*nb.down.row_bytes },
+            };
+            for (int k = 0; k < 3; ++k) {
+                bool ok;
+                switch (j.pf_hint) {
+                    case 0:  ok = pf_span<0>(spans[k][0], spans[k][1], job_seq_, seq, j.pf_abort, j.pf_abort_ctx); break;
+                    case 2:  ok = pf_span<2>(spans[k][0], spans[k][1], job_seq_, seq, j.pf_abort, j.pf_abort_ctx); break;
+                    case 3:  ok = pf_span<3>(spans[k][0], spans[k][1], job_seq_, seq, j.pf_abort, j.pf_abort_ctx); break;
+                    case 4:  ok = pf_span<4>(spans[k][0], spans[k][1], job_seq_, seq, j.pf_abort, j.pf_abort_ctx); break;
+                    default: ok = pf_span<1>(spans[k][0], spans[k][1], job_seq_, seq, j.pf_abort, j.pf_abort_ctx); break;
+                }
+                if (!ok) {
+                    return;
+                }
+            }
+        }
+    }
+
+    // leader, after the last barrier of a request: if the whole request took longer than stall_us_, say which thread was late where
+    void check_stall() {
+        const double total = (double) (tsc_now(nullptr) - t_pub_)/tpu_;
+        if (total < stall_us_) {
+            return;
+        }
+        char   buf[640];
+        int    off = snprintf(buf, sizeof(buf), "moe_hybrid: lean request #%lld took %.1f ms (threshold %.1f ms);", (long long) req_no_, total/1e3, stall_us_/1e3);
+        double pick_max = 0.0;
+        int    pick_th  = 0;
+        for (int i = 1; i < nth_; ++i) {
+            const double d = (double) ((int64_t) (arr_[(size_t) i].t_in - t_pub_))/tpu_;
+            if (d > pick_max) { pick_max = d; pick_th = i; }
+        }
+        off += snprintf(buf + off, sizeof(buf) - off, " job pickup: last thread %d after %.0f us (cpu at stage A %u);", pick_th, pick_max, arr_[(size_t) pick_th].cpu[0]);
+        static const char * names[3] = { "A", "B", "D" };
+        for (int s = 0; s < 3 && off < (int) sizeof(buf) - 120; ++s) {
+            uint64_t lo = ~(uint64_t) 0, hi = 0;
+            int      who = 0;
+            for (int i = 0; i < nth_; ++i) {
+                const uint64_t t = arr_[(size_t) i].t[s];
+                if (t < lo) { lo = t; }
+                if (t >= hi) { hi = t; who = i; }
+            }
+            off += snprintf(buf + off, sizeof(buf) - off, " stage %s: last thread %d (cpu %u) %.0f us after the first;", names[s], who, arr_[(size_t) who].cpu[s], (double) (hi - lo)/tpu_);
+        }
+        on_stall_(buf);
+    }
+
+    void execute(int ith, const job & j, tctx & tc) {
+        const layer_banks & lb = *j.lb;
+        const int           m  = j.m;
+
+        const ggml_type_traits_cpu * tu = ggml_get_type_traits_cpu(lb.up.type);
+        const ggml_type_traits_cpu * tg = ggml_get_type_traits_cpu(lb.gate.type);
+        const ggml_type_traits_cpu * td = ggml_get_type_traits_cpu(lb.down.type);
+        const ggml_type              vdt   = tu->vec_dot_type;
+        const ggml_type              vdt_d = td->vec_dot_type;
+        const ggml_from_float_t      q_x   = ggml_get_type_traits_cpu(vdt)->from_float;
+        const ggml_from_float_t      q_a   = ggml_get_type_traits_cpu(vdt_d)->from_float;
+
+        const int64_t k     = lb.up.k;
+        const int64_t n_ff  = lb.up.rows;
+        const int64_t n_out = lb.down.rows;
+
+        const bool prof = profile_ && ith == 0;
+        auto       t0   = prof ? clk::now() : clk::time_point();
+        double     ta = 0.0, tb = 0.0, tcc = 0.0;
+
+        // A. quantize the input row; the block ranges are the ones mul_mat_id hands its threads. (With the post stage on, also keep a private f32 copy of the row: the mailbox
+        // belongs to the GPU again as soon as the reply is out.)
+        {
+            const int64_t bs = ggml_blck_size(vdt);
+            const int64_t nb = k/bs;
+            const int64_t b0 = (ith*nb)/nth_;
+            const int64_t b1 = ((ith + 1)*nb)/nth_;
+            if (b1 > b0) {
+                q_x(j.x + b0*bs, xq_.p + (size_t) b0*ggml_type_size(vdt), (b1 - b0)*bs);
+                if (j.pf_lb != nullptr && j.pf_k > 0 && (int64_t) xf_.size() == k) {
+                    memcpy(xf_.data() + b0*bs, j.x + b0*bs, (size_t) ((b1 - b0)*bs)*sizeof(float));
+                }
+            }
+        }
+        arr_[(size_t) ith].t[0] = tsc_now(&arr_[(size_t) ith].cpu[0]);
+        bar_.wait(tc.ls);
+        if (prof) { ta = since_us(t0); }
+
+        // B. up and gate rows of this thread, expert by expert (two weight streams per thread)
+        {
+            const int64_t r0 = (ith*n_ff)/nth_;
+            const int64_t r1 = ((ith + 1)*n_ff)/nth_;
+            for (int e = 0; e < m; ++e) {
+                const char * pu = lb.up.data   + (size_t) j.ids[e]*lb.up.expert_bytes;
+                const char * pg = lb.gate.data + (size_t) j.ids[e]*lb.gate.expert_bytes;
+                float *      ou = up_.data()   + (size_t) e*n_ff;
+                float *      og = gate_.data() + (size_t) e*n_ff;
+                for (int64_t r = r0; r < r1; ++r) {
+                    tu->vec_dot((int) k, ou + r, 0, pu + (size_t) r*lb.up.row_bytes,   0, xq_.p, 0, 1);
+                    tg->vec_dot((int) k, og + r, 0, pg + (size_t) r*lb.gate.row_bytes, 0, xq_.p, 0, 1);
+                }
+            }
+        }
+        arr_[(size_t) ith].t[1] = tsc_now(&arr_[(size_t) ith].cpu[1]);
+        bar_.wait(tc.ls);
+        if (prof) { tb = since_us(t0); }
+
+        // C. activation and its quantization for every expert, by every thread
+        const size_t arow = ggml_row_size(vdt_d, n_ff);
+        for (int e = 0; e < m; ++e) {
+            ggml_cpu_swiglu_f32((int) n_ff, tc.act.data() + (size_t) e*n_ff, gate_.data() + (size_t) e*n_ff, up_.data() + (size_t) e*n_ff);
+            q_a(tc.act.data() + (size_t) e*n_ff, tc.actq.p + (size_t) e*arow, n_ff);
+        }
+        if (prof) { tcc = since_us(t0); }
+
+        // D. down rows of this thread, the router weights, the sum over the experts in order
+        {
+            const int64_t d0 = (ith*n_out)/nth_;
+            const int64_t d1 = ((ith + 1)*n_out)/nth_;
+            const int64_t nd = d1 - d0;
+            for (int e = 0; e < m; ++e) {
+                const char * pd = lb.down.data + (size_t) j.ids[e]*lb.down.expert_bytes;
+                float *      ex = tc.ex.data() + (size_t) e*nd;
+                const char * aq = tc.actq.p + (size_t) e*arow;
+                for (int64_t r = d0; r < d1; ++r) {
+                    td->vec_dot((int) n_ff, ex + (r - d0), 0, pd + (size_t) r*lb.down.row_bytes, 0, aq, 0, 1);
+                }
+            }
+            // the products first (their own loop), then the sums in expert order: the graph's ggml_mul and ggml_add are separate rounded operations
+            for (int e = 0; e < m; ++e) {
+                float *      ex = tc.ex.data() + (size_t) e*nd;
+                const float  we = j.w[e];
+                for (int64_t r = 0; r < nd; ++r) {
+                    ex[r] = ex[r]*we;
+                }
+            }
+            for (int64_t r = 0; r < nd; ++r) {
+                float acc = tc.ex[(size_t) r];
+                for (int e = 1; e < m; ++e) {
+                    acc = acc + tc.ex[(size_t) e*nd + (size_t) r];
+                }
+                j.y[d0 + r] = acc;
+            }
+        }
+        arr_[(size_t) ith].t[2] = tsc_now(&arr_[(size_t) ith].cpu[2]);
+        bar_.wait(tc.ls);
+        if (ith == 0 && on_stall_) {
+            check_stall();
+        }
+        if (prof) {
+            const double td_ = since_us(t0);
+            stats_.a_us += ta;
+            stats_.b_us += tb - ta;
+            stats_.c_us += tcc - tb;
+            stats_.d_us += td_ - tcc;
+            stats_.n++;
+        }
+    }
+
+    int                   nth_;
+    int                   spin_us_;
+    bool                  profile_;
+    int64_t               n_embd_;
+    int64_t               n_expert_;
+    std::function<void(int)> on_start_;
+    barrier               bar_;
+    abuf                  xq_;
+    std::vector<float>    xf_;
+    std::vector<float>    up_, gate_, logit_;
+    std::vector<tctx>     tc_;
+    job                   cur_;
+    uint32_t              cur_seq_ = 0;
+    bool                  pending_post_ = false;
+    pf_choice             choice_;
+    stage_stats           stats_;
+    struct alignas(64) arrival {
+        uint64_t t[4]   = {};
+        unsigned cpu[4] = {};
+        uint64_t t_in   = 0;
+    };
+    std::vector<arrival>  arr_;
+    double                tpu_       = 1.0;      // TSC ticks per microsecond
+    uint64_t              t_pub_     = 0;
+    int64_t               req_no_    = 0;
+    double                stall_us_  = 1e18;
+    std::function<void(const char *)> on_stall_;
+    std::atomic<uint32_t> job_seq_{0};
+    std::atomic<uint64_t> post_state_{0};
+    std::atomic<int>      ready_{0};
+    std::atomic<bool>     stop_{false};
+    std::atomic<int>      parked_{0};
+    std::mutex            mtx_;
+    std::condition_variable cv_;
+    std::vector<std::thread> workers_;
+};
+
+} // namespace moe_lean
diff --git a/tests/test-layer-streaming-cpu-leg.cpp b/tests/test-layer-streaming-cpu-leg.cpp
new file mode 100644
index 000000000..1435e2d7d
--- /dev/null
+++ b/tests/test-layer-streaming-cpu-leg.cpp
@@ -0,0 +1,88 @@
+// Host-only test for the G22 CPU-leg plumbing of the layer-major prefill (--pp-cpu-layers).
+//
+// WHY THIS EXISTS. A layer on the CPU leg has no slot, no copy and no consumer event: the graph of such a layer is built against the model's own host layer
+// tensors, and the async feed must skip it when it looks for the next layer to stage. If slot_layer() routed a CPU-leg layer to a slot bundle, the layer would
+// compute with whatever another layer left in that slot (a silently wrong answer); if the feed offered a CPU-leg layer to the copy worker, the worker would copy a
+// bank nobody consumes over a slot that is still in use. Neither shows in a speed number, so the routing is checked here without a GPU or a model.
+//
+// NO GPU, NO MODEL. Everything runs through the production symbols llama_layer_streaming::slot_layer, ::af_next_layer, ::set_pp_cpu_layers, ::is_cpu_leg and
+// ::has_cpu_leg.
+
+#include "../src/llama-layer-streaming.h"
+
+#include <cstdio>
+#include <vector>
+
+static int failures = 0;
+
+static void expect(bool cond, const char * what) {
+    if (cond) {
+        fprintf(stderr, "ok   %s\n", what);
+    } else {
+        fprintf(stderr, "FAIL %s\n", what);
+        failures++;
+    }
+}
+
+int main() {
+    typedef llama_layer_streaming LS;
+
+    LS ls;
+    ls.n_layer = 8;
+    ls.n_slots = 2;
+    std::vector<llama_layer> host(8);
+    for (int il = 0; il < 8; ++il) {
+        ls.host_layers.push_back(&host[il]);
+    }
+    ls.slots.resize(2);
+    for (int il = 0; il < 8; ++il) {
+        ls.slots[il % 2].layers[il] = llama_layer();
+    }
+
+    fprintf(stderr, "\n== default: nothing on the CPU leg ==\n");
+    expect(!ls.has_cpu_leg(), "no CPU-leg layer by default");
+    expect(!ls.is_cpu_leg(3), "layer 3 streams by default");
+    expect(&ls.slot_layer(3) == &ls.slots[1].layers.at(3), "slot_layer(3) is the bundle of slot 1");
+    expect(ls.next_streamed_layer(2) == 3, "the feed offers layer 3 after layer 2");
+
+    fprintf(stderr, "\n== set_pp_cpu_layers {1,3,4} ==\n");
+    expect(ls.set_pp_cpu_layers({1, 3, 4}), "a valid list is accepted");
+    expect(ls.has_cpu_leg(), "has_cpu_leg");
+    expect(!ls.is_cpu_leg(0) && ls.is_cpu_leg(1) && !ls.is_cpu_leg(2) && ls.is_cpu_leg(3) && ls.is_cpu_leg(4) && !ls.is_cpu_leg(5), "is_cpu_leg marks exactly 1, 3, 4");
+    expect(!ls.is_cpu_leg(-1) && !ls.is_cpu_leg(8) && !ls.is_cpu_leg(100), "out-of-range layers are never CPU-leg");
+
+    fprintf(stderr, "\n== routing: prefill (phase 0) reads host tensors for the CPU-leg layers only ==\n");
+    ls.phase = 0;
+    expect(&ls.slot_layer(1) == &host[1], "layer 1 reads the host layer");
+    expect(&ls.slot_layer(3) == &host[3], "layer 3 reads the host layer");
+    expect(&ls.slot_layer(4) == &host[4], "layer 4 reads the host layer");
+    expect(&ls.slot_layer(0) == &ls.slots[0].layers.at(0), "layer 0 still reads its slot bundle");
+    expect(&ls.slot_layer(2) == &ls.slots[0].layers.at(2), "layer 2 still reads its slot bundle");
+    expect(&ls.slot_layer(5) == &ls.slots[1].layers.at(5), "layer 5 still reads its slot bundle");
+
+    fprintf(stderr, "\n== routing: decode (phase 1) is untouched ==\n");
+    ls.phase = 1;
+    expect(&ls.slot_layer(1) == &ls.slots[1].layers.at(1), "layer 1 reads its slot bundle in phase 1");
+    expect(&ls.slot_layer(4) == &ls.slots[0].layers.at(4), "layer 4 reads its slot bundle in phase 1");
+    ls.phase = 0;
+
+    fprintf(stderr, "\n== the feed skips CPU-leg layers ==\n");
+    expect(ls.next_streamed_layer(0) == 2, "after layer 0 the feed offers layer 2 (1 is CPU)");
+    expect(ls.next_streamed_layer(2) == 5, "after layer 2 the feed offers layer 5 (3 and 4 are CPU)");
+    expect(ls.next_streamed_layer(5) == 6, "after layer 5 the feed offers layer 6");
+    expect(ls.next_streamed_layer(7) == -1, "after the last layer there is nothing to offer");
+    ls.exec_layers = {0, 1, 2, 3, 4, 5};
+    expect(ls.next_streamed_layer(2) == 5, "with a layer subset the feed still skips 3 and 4");
+    expect(ls.next_streamed_layer(5) == -1, "and ends at the end of the subset");
+    ls.exec_layers.clear();
+
+    fprintf(stderr, "\n== refusals ==\n");
+    expect(!ls.set_pp_cpu_layers({2, 8}), "a layer beyond the last is refused");
+    expect(!ls.has_cpu_leg(), "a refused list leaves no CPU-leg layer behind");
+    expect(!ls.set_pp_cpu_layers({-1}), "a negative layer is refused");
+    expect(ls.set_pp_cpu_layers({}), "an empty list is the all-GPU configuration");
+    expect(!ls.has_cpu_leg() && ls.next_streamed_layer(0) == 1, "and streams everything again");
+
+    fprintf(stderr, "\n%s (%d failure%s)\n", failures == 0 ? "PASS" : "FAIL", failures, failures == 1 ? "" : "s");
+    return failures == 0 ? 0 : 1;
+}
diff --git a/tests/test-moe-lean-expert.cpp b/tests/test-moe-lean-expert.cpp
new file mode 100644
index 000000000..abf5d4c01
--- /dev/null
+++ b/tests/test-moe-lean-expert.cpp
@@ -0,0 +1,707 @@
+// G14: host-only bitwise equivalence of the lean expert leg (src/llama-moe-lean.h) against the ggml graph the hybrid MoE engine used before it
+// (src/llama-moe-hybrid.cpp, build_host_graph: mul_mat_id up, mul_mat_id gate, swiglu, mul_mat_id down, multiply by the router weights, sum over the experts in order).
+//
+// No CUDA, no model, no GPU. Random expert banks are quantized to the types a model may use; for every type pair, every number of missed experts m = 1 .. 8, every thread count
+// of the lean team and a series of random requests, the lean result must equal the graph result BIT FOR BIT (memcmp), not within a tolerance: the two paths call the same
+// quantizers, the same vec_dot kernels and the same swiglu routine, so any difference is a defect (a wrong slice, a missed barrier, a fused multiply-add).
+//
+//   test-moe-lean-expert                run the equivalence checks (what ctest runs)
+//   test-moe-lean-expert --bench-pf [N] [cpus]   hot against cold: the cost of a request whose experts were prefetched into the workers' caches after the previous request
+//   test-moe-lean-expert --bench [N]    time the graph against the lean team at the real shapes (Qwen3.6-35B-A3B: n_embd 2048, n_ff 512, 256 experts, Q4_K),
+//                                       N requests per miss count (default 1500); informational, not a check
+#include "../src/llama-moe-lean.h"
+
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+#include "ggml.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <random>
+#include <string>
+#include <thread>
+#include <vector>
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#endif
+
+static int n_checks   = 0;
+static int n_failures = 0;
+
+#define CHECK(cond, ...)                                  \
+    do {                                                  \
+        ++n_checks;                                       \
+        if (!(cond)) {                                    \
+            ++n_failures;                                 \
+            std::printf("FAIL %s:%d: ", __FILE__, __LINE__); \
+            std::printf(__VA_ARGS__);                     \
+            std::printf("\n");                            \
+        }                                                 \
+    } while (0)
+
+// CPU seconds this process has used so far
+static double process_cpu_seconds() {
+#ifdef _WIN32
+    FILETIME c, e, k, u;
+    if (GetProcessTimes(GetCurrentProcess(), &c, &e, &k, &u)) {
+        const auto to_s = [](const FILETIME & f) { return (double) (((uint64_t) f.dwHighDateTime << 32) | f.dwLowDateTime) * 1e-7; };
+        return to_s(k) + to_s(u);
+    }
+    return 0.0;
+#else
+    return (double) std::clock()/CLOCKS_PER_SEC;
+#endif
+}
+
+static void pin_cpu(int cpu) {
+#ifdef _WIN32
+    if (cpu >= 0 && cpu < 64) {
+        SetThreadAffinityMask(GetCurrentThread(), (DWORD_PTR) 1 << cpu);
+    }
+#else
+    (void) cpu;
+#endif
+}
+
+static void set_high_priority() {
+#ifdef _WIN32
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_HIGHEST);
+#endif
+}
+
+// the host graph of the engine, op for op (llama-moe-hybrid.cpp, moe_hybrid_engine::build_host_graph)
+struct ref_graph {
+    ggml_context * ctx = nullptr;
+    ggml_cgraph *  gf  = nullptr;
+    ggml_gallocr_t ga  = nullptr;
+    ggml_tensor *  x = nullptr, * ids = nullptr, * w = nullptr, * out = nullptr;
+
+    bool build(ggml_tensor * h_up, ggml_tensor * h_gate, ggml_tensor * h_down, int n_embd, int m) {
+        ggml_init_params ip = { ggml_tensor_overhead()*64 + ggml_graph_overhead_custom(64, false), nullptr, true };
+        ctx = ggml_init(ip);
+        x   = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_embd, 1);
+        ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, m, 1);
+        w   = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 1, m, 1);
+        ggml_set_input(x);
+        ggml_set_input(ids);
+        ggml_set_input(w);
+
+        ggml_tensor * cur  = ggml_reshape_3d(ctx, x, n_embd, 1, 1);
+        ggml_tensor * up   = ggml_mul_mat_id(ctx, h_up,   cur, ids);
+        ggml_tensor * gate = ggml_mul_mat_id(ctx, h_gate, cur, ids);
+        ggml_tensor * act  = ggml_swiglu_split(ctx, gate, up);
+        ggml_tensor * ex   = ggml_mul_mat_id(ctx, h_down, act, ids);
+        ex = ggml_mul(ctx, ex, w);
+
+        gf = ggml_new_graph_custom(ctx, 64, false);
+        ggml_build_forward_expand(gf, ex);
+        ggml_tensor * views[8];
+        for (int i = 0; i < m; ++i) {
+            views[i] = ggml_view_2d(ctx, ex, n_embd, 1, ex->nb[2], i*ex->nb[1]);
+            ggml_build_forward_expand(gf, views[i]);
+        }
+        ggml_tensor * o = views[0];
+        for (int i = 1; i < m; ++i) {
+            o = ggml_add(ctx, o, views[i]);
+            ggml_build_forward_expand(gf, o);
+        }
+        if (m == 1) {
+            o = ggml_cont(ctx, o);
+        }
+        ggml_set_output(o);
+        ggml_build_forward_expand(gf, o);
+        out = o;
+
+        ga = ggml_gallocr_new(ggml_backend_cpu_buffer_type());
+        return ga != nullptr && ggml_gallocr_alloc_graph(ga, gf);
+    }
+
+    ~ref_graph() {
+        if (ga)  { ggml_gallocr_free(ga); }
+        if (ctx) { ggml_free(ctx); }
+    }
+};
+
+struct layer_weights {
+    ggml_context *        ctx = nullptr;
+    ggml_backend_buffer_t buf = nullptr;
+    ggml_tensor *         up = nullptr, * gate = nullptr, * down = nullptr;
+
+    ~layer_weights() {
+        if (buf) { ggml_backend_buffer_free(buf); }
+        if (ctx) { ggml_free(ctx); }
+    }
+};
+
+static bool make_layer(layer_weights & lw, ggml_backend_t cpu, ggml_type t_ud, ggml_type t_down, int n_embd, int n_ff, int n_expert, bool replicate, uint32_t seed) {
+    ggml_init_params ip = { ggml_tensor_overhead()*8, nullptr, true };
+    lw.ctx  = ggml_init(ip);
+    lw.up   = ggml_new_tensor_3d(lw.ctx, t_ud,   n_embd, n_ff,   n_expert);
+    lw.gate = ggml_new_tensor_3d(lw.ctx, t_ud,   n_embd, n_ff,   n_expert);
+    lw.down = ggml_new_tensor_3d(lw.ctx, t_down, n_ff,   n_embd, n_expert);
+    lw.buf  = ggml_backend_alloc_ctx_tensors(lw.ctx, cpu);
+    if (lw.buf == nullptr) {
+        return false;
+    }
+
+    std::mt19937                          rng(seed);
+    std::normal_distribution<float>       nd(0.0f, 1.0f);
+    ggml_tensor *                         ts[3] = { lw.up, lw.gate, lw.down };
+    for (ggml_tensor * t : ts) {
+        const int64_t k    = t->ne[0];
+        const int64_t rows = t->ne[1];
+        std::vector<float> src((size_t) k*rows);
+        const int n_gen = replicate ? 1 : n_expert;
+        for (int e = 0; e < n_gen; ++e) {
+            const float scale = 1.0f/std::sqrt((float) k);
+            for (auto & v : src) {
+                v = nd(rng)*scale;
+            }
+            ggml_quantize_chunk(t->type, src.data(), (char *) t->data + (size_t) e*t->nb[2], 0, rows, k, nullptr);
+        }
+        for (int e = n_gen; e < n_expert; ++e) {
+            memcpy((char *) t->data + (size_t) e*t->nb[2], t->data, t->nb[2]);
+        }
+    }
+    return true;
+}
+
+static moe_lean::layer_banks banks_of(const layer_weights & lw) {
+    moe_lean::layer_banks lb;
+    lb.up   = moe_lean::bank_of(lw.up);
+    lb.gate = moe_lean::bank_of(lw.gate);
+    lb.down = moe_lean::bank_of(lw.down);
+    return lb;
+}
+
+struct type_pair {
+    ggml_type   ud, down;
+    const char * name;
+};
+
+static void check_pair(ggml_backend_t cpu, const type_pair & tp, int n_embd, int n_ff, int n_expert) {
+    if (ggml_quantize_requires_imatrix(tp.ud) || ggml_quantize_requires_imatrix(tp.down)) {
+        std::printf("skip %s (needs an importance matrix)\n", tp.name);
+        return;
+    }
+    std::printf("%s: quantizing the banks ...\n", tp.name);
+    layer_weights lw;
+    if (!make_layer(lw, cpu, tp.ud, tp.down, n_embd, n_ff, n_expert, false, 12345u)) {
+        CHECK(false, "%s: weight allocation failed", tp.name);
+        return;
+    }
+    std::printf("%s: banks ready, comparing ...\n", tp.name);
+    const moe_lean::layer_banks lb = banks_of(lw);
+    if (!moe_lean::supported(lb)) {
+        std::printf("note %s: the lean leg does not take this type pair (the engine keeps the graph for it)\n", tp.name);
+        return;
+    }
+
+    ggml_backend_cpu_set_n_threads(cpu, 4);
+
+    std::vector<ref_graph> graphs(9);
+    for (int m = 1; m <= 8; ++m) {
+        CHECK(graphs[(size_t) m].build(lw.up, lw.gate, lw.down, n_embd, m), "%s: graph m=%d allocation", tp.name, m);
+    }
+
+    std::mt19937                    rng(777u);
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    std::uniform_real_distribution<float> ud(0.02f, 0.6f);
+
+    const int thread_counts[] = { 1, 2, 3, 5, 8 };
+    int       bad = 0, total = 0;
+    for (int nth : thread_counts) {
+        moe_lean::team team(nth, n_embd, n_ff, 0, nullptr, 2000);
+        for (int m = 1; m <= 8; ++m) {
+            for (int rep = 0; rep < 6; ++rep) {
+                std::vector<float>   x((size_t) n_embd);
+                std::vector<int32_t> pool((size_t) n_expert);
+                float                w[8];
+                for (auto & v : x) { v = nd(rng); }
+                for (int i = 0; i < n_expert; ++i) { pool[(size_t) i] = i; }
+                std::shuffle(pool.begin(), pool.end(), rng);
+                for (int i = 0; i < m; ++i) { w[i] = ud(rng); }
+
+                ref_graph & g = graphs[(size_t) m];
+                memcpy(g.x->data,   x.data(),    (size_t) n_embd*sizeof(float));
+                memcpy(g.ids->data, pool.data(), (size_t) m*sizeof(int32_t));
+                memcpy(g.w->data,   w,           (size_t) m*sizeof(float));
+                const ggml_status st = ggml_backend_graph_compute(cpu, g.gf);
+                CHECK(st == GGML_STATUS_SUCCESS, "%s: graph compute", tp.name);
+
+                std::vector<float> y((size_t) n_embd, -1.0f);
+                moe_lean::job j;
+                j.lb = &lb; j.m = m; j.ids = pool.data(); j.w = w; j.x = x.data(); j.y = y.data();
+                team.run(j);
+
+                ++total;
+                if (memcmp(y.data(), g.out->data, (size_t) n_embd*sizeof(float)) != 0) {
+                    ++bad;
+                    int first = -1, nd_ = 0;
+                    double maxd = 0.0;
+                    const float * ref = (const float *) g.out->data;
+                    for (int i = 0; i < n_embd; ++i) {
+                        if (memcmp(&y[(size_t) i], &ref[i], sizeof(float)) != 0) {
+                            if (first < 0) { first = i; }
+                            ++nd_;
+                            maxd = std::max(maxd, (double) std::fabs(y[(size_t) i] - ref[i]));
+                        }
+                    }
+                    if (bad <= 3) {
+                        std::printf("  %s nth=%d m=%d rep=%d: %d of %d floats differ, first at %d (lean %.9g, graph %.9g), max |diff| %.3g\n",
+                                    tp.name, nth, m, rep, nd_, n_embd, first, (double) y[(size_t) first], (double) ref[first], maxd);
+                    }
+                }
+            }
+        }
+    }
+    CHECK(bad == 0, "%s: %d of %d requests differ from the graph", tp.name, bad, total);
+    std::printf("%-22s %4d requests x (thread counts 1,2,3,5,8) %s\n", tp.name, total, bad == 0 ? "bit-identical" : "DIFFER");
+}
+
+// G15: the post stage after the reply (router logits of the next layer on the request row, one barrier, the first K non-resident experts of the top ranks, prefetch of the
+// workers' slices). It must change no result bit, must choose exactly the experts a single-threaded reference chooses, and must not leave a worker waiting when the leader skips it
+// or forgets it.
+static void check_post_stage(ggml_backend_t cpu) {
+    const int n_embd = 512, n_ff = 256, n_expert = 64;
+    layer_weights cur, nxt;
+    if (!make_layer(cur, cpu, GGML_TYPE_Q4_K, GGML_TYPE_Q4_K, n_embd, n_ff, n_expert, false, 21u) ||
+        !make_layer(nxt, cpu, GGML_TYPE_Q4_K, GGML_TYPE_Q4_K, n_embd, n_ff, n_expert, false, 22u)) {
+        CHECK(false, "post stage: weight allocation failed");
+        return;
+    }
+    const moe_lean::layer_banks lb  = banks_of(cur);
+    const moe_lean::layer_banks lbn = banks_of(nxt);
+
+    std::mt19937                    rng(99u);
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    std::vector<float>              router((size_t) n_expert*n_embd);
+    for (auto & v : router) { v = nd(rng)/std::sqrt((float) n_embd); }
+    const std::vector<char> rq = moe_lean::quantize_router_q8(router.data(), n_expert, n_embd);
+
+    const ggml_type_traits_cpu * t8   = ggml_get_type_traits_cpu(GGML_TYPE_Q8_0);
+    const size_t                 rrow = ggml_row_size(GGML_TYPE_Q8_0, n_embd);
+
+    int bad = 0, total = 0, chosen_total = 0;
+    for (int nth : { 1, 2, 3, 5, 8 }) {
+        moe_lean::team team(nth, n_embd, n_ff, n_expert, nullptr, 2000);
+        for (int trial = 0; trial < 40; ++trial) {
+            std::vector<float>   x((size_t) n_embd), y0((size_t) n_embd), y1((size_t) n_embd);
+            for (auto & v : x) { v = nd(rng); }
+            std::vector<int32_t> pool((size_t) n_expert);
+            for (int i = 0; i < n_expert; ++i) { pool[(size_t) i] = i; }
+            std::shuffle(pool.begin(), pool.end(), rng);
+            const int            m = 1 + trial % 4;
+            float                w[8];
+            for (int i = 0; i < 8; ++i) { w[i] = 0.1f + 0.05f*(float) i; }
+            std::vector<int32_t> map((size_t) n_expert);
+            for (int e = 0; e < n_expert; ++e) { map[(size_t) e] = (rng() % 100) < 40 ? (int32_t) (rng() % 16) : -1; }
+            const int K    = 1 + trial % 3;
+            const int pool_n = 4 + (trial % 3)*4;                    // 4, 8, 12
+
+            // the result without a post stage
+            moe_lean::job j0;
+            j0.lb = &lb; j0.m = m; j0.ids = pool.data(); j0.w = w; j0.x = x.data(); j0.y = y0.data();
+            team.run(j0);
+
+            // the same request with the post stage on
+            moe_lean::job j1 = j0;
+            j1.y = y1.data(); j1.pf_lb = &lbn; j1.pf_rw = rq.data(); j1.pf_map = map.data(); j1.pf_k = K; j1.pf_pool = pool_n; j1.pf_hint = trial % 4;
+            team.run(j1);
+            const int mode = trial % 4;                              // 0,1,2: post(true); 3: the caller skips and the next run() settles it
+            if (mode == 3) {
+                // no post() call at all; the next run() must settle it as "skip"
+            } else {
+                team.post(mode != 2);
+            }
+            ++total;
+            if (memcmp(y0.data(), y1.data(), (size_t) n_embd*sizeof(float)) != 0) { ++bad; }
+
+            if (mode == 0 || mode == 1) {
+                // single-threaded reference of the choice: the same quantized row and dot products, top ranks, ties to the lower id, then the first K non-resident
+                std::vector<char>  xq(rrow + 64);
+                t8->from_float(x.data(), xq.data(), n_embd);
+                std::vector<float> lg((size_t) n_expert);
+                for (int e = 0; e < n_expert; ++e) {
+                    t8->vec_dot(n_embd, &lg[(size_t) e], 0, rq.data() + (size_t) e*rrow, 0, xq.data(), 0, 1);
+                }
+                std::vector<int> ord((size_t) n_expert);
+                for (int e = 0; e < n_expert; ++e) { ord[(size_t) e] = e; }
+                std::stable_sort(ord.begin(), ord.end(), [&](int a, int b) { return lg[(size_t) a] > lg[(size_t) b]; });
+                std::vector<int> want;
+                for (int r = 0; r < pool_n && (int) want.size() < K; ++r) {
+                    if (map[(size_t) ord[(size_t) r]] < 0) { want.push_back(ord[(size_t) r]); }
+                }
+                const moe_lean::pf_choice & c = team.last_choice();
+                bool same = c.n == (int) want.size();
+                for (int i = 0; same && i < c.n; ++i) { same = c.ids[i] == want[(size_t) i]; }
+                ++total;
+                chosen_total += c.n;
+                if (!same) {
+                    ++bad;
+                    if (bad <= 3) {
+                        std::printf("  post stage nth=%d trial=%d: chose %d experts (", nth, trial, c.n);
+                        for (int i = 0; i < c.n; ++i) { std::printf("%d ", c.ids[i]); }
+                        std::printf(") want %zu (", want.size());
+                        for (int e : want) { std::printf("%d ", e); }
+                        std::printf(")\n");
+                    }
+                }
+            }
+        }
+        // a forced choice (the test hook the benchmark uses) and a final plain request after the last post
+        moe_lean::job jf;
+        std::vector<float> x((size_t) n_embd, 0.5f), y((size_t) n_embd);
+        const int32_t ids[2] = { 3, 7 };
+        const float   w[2]   = { 0.6f, 0.4f };
+        jf.lb = &lb; jf.m = 2; jf.ids = ids; jf.w = w; jf.x = x.data(); jf.y = y.data();
+        jf.pf_lb = &lbn; jf.pf_force = ids; jf.pf_k = 2;
+        team.run(jf);
+        team.post(true);
+        ++total;
+        CHECK(team.last_choice().n == 2 && team.last_choice().ids[0] == 3 && team.last_choice().ids[1] == 7, "forced prefetch choice");
+        team.run(jf);   // post left unanswered on purpose: run() settles it
+        jf.pf_lb = nullptr; jf.pf_k = 0;
+        team.run(jf);
+    }
+    CHECK(bad == 0, "post stage: %d of %d checks failed", bad, total);
+    std::printf("post stage             %4d checks (results unchanged, choices equal to the reference, skip / forget settle), %d experts chosen: %s\n",
+                total, chosen_total, bad == 0 ? "ok" : "FAIL");
+}
+
+// hot against cold at the real shapes. Request A (one expert of layer a) is followed by request B (two experts of layer b) after a gap, as in the engine; B's experts were
+// prefetched into the workers' caches right after A's reply (hot), or other experts of layer b were (wrong), or nothing was (cold). The time of B is what is compared.
+static void bench_pf(ggml_backend_t cpu, int reqs, std::vector<int> cpus) {
+    const int n_embd = 2048, n_ff = 512, n_expert = 256, n_layer = 6;
+    if (cpus.empty()) {
+        for (int i = 0; i < 8; ++i) { cpus.push_back(2*i); }
+    }
+    const int nth = (int) cpus.size();
+    std::vector<layer_weights>         lws((size_t) n_layer);
+    std::vector<moe_lean::layer_banks> lbs((size_t) n_layer);
+    std::printf("bench-pf: building %d layers x 3 x %.0f MiB (Q4_K, 256 experts) ...\n", n_layer, 144.0);
+    for (int l = 0; l < n_layer; ++l) {
+        if (!make_layer(lws[(size_t) l], cpu, GGML_TYPE_Q4_K, GGML_TYPE_Q4_K, n_embd, n_ff, n_expert, true, 99u + (uint32_t) l)) {
+            std::printf("allocation failed\n");
+            return;
+        }
+        lbs[(size_t) l] = banks_of(lws[(size_t) l]);
+    }
+    std::mt19937                    rng(777u);
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    std::vector<float>              x((size_t) n_embd), y((size_t) n_embd);
+    for (auto & v : x) { v = nd(rng); }
+    float w[8] = { 0.3f, 0.2f, 0.15f, 0.1f, 0.08f, 0.07f, 0.05f, 0.05f };
+
+    set_high_priority();
+    pin_cpu(cpus.back());
+    moe_lean::team team(nth, n_embd, n_ff, n_expert, [&](int ith) { pin_cpu(cpus[(size_t) ith - 1]); set_high_priority(); }, 20000, true);
+
+    using clk = std::chrono::steady_clock;
+    auto spin_us = [](double us) {
+        const auto t = clk::now();
+        while (std::chrono::duration<double, std::micro>(clk::now() - t).count() < us) { MOE_LEAN_PAUSE(); }
+    };
+    auto stat = [](std::vector<double> & v, double & mean, double & p50) {
+        std::sort(v.begin(), v.end());
+        double s = 0.0;
+        for (double d : v) { s += d; }
+        mean = s/(double) v.size();
+        p50  = v[v.size()/2];
+    };
+
+    std::printf("\nB = 2 experts of layer b after A = 1 expert of layer a, gap between A's reply and B in the table; us per request B, %d trials per cell, %d threads on CPUs", reqs, nth);
+    for (int c : cpus) { std::printf(" %d", c); }
+    std::printf("\n gap  hint | cold mean  p50 | hot(K=2) mean  p50  saved | wrong mean  p50  | post stage us\n");
+    for (int hint : { 4, 1, 0, 2, 3 }) {
+        for (double gap : { 40.0, 70.0, 100.0, 150.0 }) {
+            if (hint != 1 && hint != 4 && gap != 100.0) { continue; }
+            std::vector<double> t_cold, t_hot, t_wrong, t_rep;
+            double post_us0 = team.stats().post_us;
+            int64_t post_n0 = team.stats().n_post;
+            for (int i = 0; i < reqs*4 + 60; ++i) {
+                const int mode = i % 4;                                  // 0 cold, 1 hot, 2 wrong, 3 repeat (the same request B twice in a row: the second is the ideal hot case)
+                const int la = (int) (rng() % (uint32_t) n_layer);
+                int lb_ = (int) (rng() % (uint32_t) n_layer);
+                if (lb_ == la) { lb_ = (lb_ + 1) % n_layer; }
+                int32_t ea[1] = { (int32_t) (rng() % (uint32_t) n_expert) };
+                int32_t eb[2], ew[2];
+                eb[0] = (int32_t) (rng() % (uint32_t) n_expert);
+                do { eb[1] = (int32_t) (rng() % (uint32_t) n_expert); } while (eb[1] == eb[0]);
+                do { ew[0] = (int32_t) (rng() % (uint32_t) n_expert); } while (ew[0] == eb[0] || ew[0] == eb[1]);
+                do { ew[1] = (int32_t) (rng() % (uint32_t) n_expert); } while (ew[1] == ew[0] || ew[1] == eb[0] || ew[1] == eb[1]);
+                moe_lean::job ja;
+                ja.lb = &lbs[(size_t) la]; ja.m = 1; ja.ids = ea; ja.w = w; ja.x = x.data(); ja.y = y.data();
+                if (mode == 1 || mode == 2) {
+                    ja.pf_lb = &lbs[(size_t) lb_]; ja.pf_k = 2; ja.pf_hint = hint; ja.pf_force = (mode == 1) ? eb : ew;
+                }
+                team.run(ja);
+                team.post(mode == 1 || mode == 2);
+                spin_us(gap);
+                moe_lean::job jb;
+                jb.lb = &lbs[(size_t) lb_]; jb.m = 2; jb.ids = eb; jb.w = w; jb.x = x.data(); jb.y = y.data();
+                if (mode == 3) {
+                    team.run(jb);                                        // the first read brings the experts into the caches
+                    spin_us(gap);
+                }
+                const auto t0 = clk::now();
+                team.run(jb);
+                const double us = std::chrono::duration<double, std::micro>(clk::now() - t0).count();
+                if (i >= 60) { (mode == 0 ? t_cold : mode == 1 ? t_hot : mode == 2 ? t_wrong : t_rep).push_back(us); }
+                spin_us(30.0);
+            }
+            double mc, pc, mh, ph, mw, pw, mr, pr;
+            stat(t_cold, mc, pc); stat(t_hot, mh, ph); stat(t_wrong, mw, pw); stat(t_rep, mr, pr);
+            const double post_avg = (team.stats().post_us - post_us0)/(double) std::max<int64_t>(1, team.stats().n_post - post_n0);
+            std::printf(" %4.0f  %d    | %9.1f %6.1f | %9.1f %6.1f %6.1f | %9.1f %6.1f | %6.1f | repeat (ideal hot) %6.1f %6.1f\n", gap, hint, mc, pc, mh, ph, mc - mh, mw, pw, post_avg, mr, pr);
+        }
+    }
+    std::printf("(saved = cold mean - hot mean for a request of 2 experts; per expert divide by 2. 'wrong' = two other experts of the layer were prefetched.)\n");
+}
+
+// micro-benchmark at the real shapes: one request = m random experts of one of n_layer layers (a working set far above the caches, so the weights come from DRAM)
+static void bench(ggml_backend_t cpu, int reqs, std::vector<int> cpus) {
+    const int n_embd = 2048, n_ff = 512, n_expert = 256, n_layer = 6;
+    if (cpus.empty()) {
+        for (int i = 0; i < 8; ++i) { cpus.push_back(2*i); }
+    }
+    const int nth = (int) cpus.size();
+    std::vector<layer_weights> lws((size_t) n_layer);
+    std::vector<moe_lean::layer_banks> lbs((size_t) n_layer);
+    std::printf("bench: building %d layers x 3 x %.0f MiB (Q4_K, 256 experts) ...\n", n_layer, 144.0);
+    for (int l = 0; l < n_layer; ++l) {
+        if (!make_layer(lws[(size_t) l], cpu, GGML_TYPE_Q4_K, GGML_TYPE_Q4_K, n_embd, n_ff, n_expert, true, 99u + (uint32_t) l)) {
+            std::printf("bench: allocation failed\n");
+            return;
+        }
+        lbs[(size_t) l] = banks_of(lws[(size_t) l]);
+    }
+
+    // graph path, set up as the engine does it: its own pinned, polling thread pool created on the calling thread
+    ggml_threadpool_params tpp = ggml_threadpool_params_default(nth);
+    memset(tpp.cpumask, 0, sizeof(tpp.cpumask));
+    for (int c : cpus) {
+        tpp.cpumask[c] = true;
+    }
+    tpp.strict_cpu = true;
+    tpp.poll       = 100;
+    tpp.prio       = GGML_SCHED_PRIO_HIGH;
+    ggml_threadpool * tp = ggml_threadpool_new(&tpp);
+    ggml_backend_cpu_set_threadpool(cpu, tp);
+    ggml_backend_cpu_set_n_threads(cpu, nth);
+
+    std::vector<std::vector<ref_graph>> graphs((size_t) n_layer, std::vector<ref_graph>(9));
+    for (int l = 0; l < n_layer; ++l) {
+        for (int m = 1; m <= 8; ++m) {
+            graphs[(size_t) l][(size_t) m].build(lws[(size_t) l].up, lws[(size_t) l].gate, lws[(size_t) l].down, n_embd, m);
+        }
+    }
+
+    std::mt19937                    rng(4242u);
+    std::normal_distribution<float> nd(0.0f, 1.0f);
+    std::vector<float>              x((size_t) n_embd), y((size_t) n_embd);
+    for (auto & v : x) { v = nd(rng); }
+    std::vector<int32_t> pool((size_t) n_expert);
+    for (int i = 0; i < n_expert; ++i) { pool[(size_t) i] = i; }
+    float w[8] = { 0.3f, 0.2f, 0.15f, 0.1f, 0.08f, 0.07f, 0.05f, 0.05f };
+
+    using clk = std::chrono::steady_clock;
+    struct res { double mean, p50, p99; };
+    auto stat = [](std::vector<double> & v) {
+        std::sort(v.begin(), v.end());
+        double s = 0.0;
+        for (double d : v) { s += d; }
+        return res{ s/(double) v.size(), v[v.size()/2], v[(size_t) ((double) v.size()*0.99)] };
+    };
+
+    std::vector<res> r_graph(9), r_lean(9);
+    {
+        // the graph path: the calling thread is worker 0 of the pool (pinned by ggml_threadpool_new to the last CPU of the mask)
+        for (int m = 1; m <= 8; ++m) {
+            std::vector<double> t;
+            for (int i = 0; i < reqs + 100; ++i) {
+                const int l = (int) (rng() % (uint32_t) n_layer);
+                std::shuffle(pool.begin(), pool.end(), rng);
+                ref_graph & g = graphs[(size_t) l][(size_t) m];
+                memcpy(g.x->data, x.data(), (size_t) n_embd*sizeof(float));
+                memcpy(g.ids->data, pool.data(), (size_t) m*sizeof(int32_t));
+                memcpy(g.w->data, w, (size_t) m*sizeof(float));
+                const auto t0 = clk::now();
+                ggml_backend_graph_compute(cpu, g.gf);
+                const double us = std::chrono::duration<double, std::micro>(clk::now() - t0).count();
+                if (i >= 100) { t.push_back(us); }
+                // a short idle gap like the engine sees between two requests
+                const auto tg = clk::now();
+                while (std::chrono::duration<double, std::micro>(clk::now() - tg).count() < 40.0) { MOE_LEAN_PAUSE(); }
+            }
+            r_graph[(size_t) m] = stat(t);
+        }
+    }
+    ggml_backend_cpu_set_threadpool(cpu, nullptr);
+    ggml_threadpool_free(tp);
+    graphs.clear();
+
+    {
+        set_high_priority();
+        pin_cpu(cpus.back());
+        moe_lean::team team(nth, n_embd, n_ff, 0, [&](int ith) { pin_cpu(cpus[(size_t) ith - 1]); set_high_priority(); }, 4000, true);
+        for (int m = 1; m <= 8; ++m) {
+            std::vector<double> t;
+            for (int i = 0; i < reqs + 100; ++i) {
+                const int l = (int) (rng() % (uint32_t) n_layer);
+                std::shuffle(pool.begin(), pool.end(), rng);
+                moe_lean::job j;
+                j.lb = &lbs[(size_t) l]; j.m = m; j.ids = pool.data(); j.w = w; j.x = x.data(); j.y = y.data();
+                const auto t0 = clk::now();
+                team.run(j);
+                const double us = std::chrono::duration<double, std::micro>(clk::now() - t0).count();
+                if (i >= 100) { t.push_back(us); }
+                const auto tg = clk::now();
+                while (std::chrono::duration<double, std::micro>(clk::now() - tg).count() < 40.0) { MOE_LEAN_PAUSE(); }
+            }
+            r_lean[(size_t) m] = stat(t);
+        }
+        const moe_lean::stage_stats & s = team.stats();
+        std::printf("lean stages as thread 0 sees them (mean per request over all m): A %.2f  B %.2f  C %.2f  D %.2f us (n=%lld)\n",
+                    s.a_us/(double) s.n, s.b_us/(double) s.n, s.c_us/(double) s.n, s.d_us/(double) s.n, (long long) s.n);
+    }
+
+    std::string cpu_list;
+    for (int c : cpus) { cpu_list += (cpu_list.empty() ? "" : ",") + std::to_string(c); }
+    std::printf("\n m | graph mean  p50   p99 | lean mean  p50   p99 | saved (mean)   [us per request, %d requests per m, %d threads on CPUs %s]\n", reqs, nth, cpu_list.c_str());
+    for (int m = 1; m <= 8; ++m) {
+        const res & a = r_graph[(size_t) m];
+        const res & b = r_lean[(size_t) m];
+        std::printf(" %d | %9.1f %6.1f %6.1f | %8.1f %6.1f %6.1f | %6.1f\n", m, a.mean, a.p50, a.p99, b.mean, b.p50, b.p99, a.mean - b.mean);
+    }
+    // linear fit mean = fixed + slope*m
+    for (int pass = 0; pass < 2; ++pass) {
+        const std::vector<res> & r = pass == 0 ? r_graph : r_lean;
+        double sx = 0, sy = 0, sxx = 0, sxy = 0;
+        for (int m = 1; m <= 8; ++m) { sx += m; sy += r[(size_t) m].mean; sxx += (double) m*m; sxy += m*r[(size_t) m].mean; }
+        const double slope = (8*sxy - sx*sy)/(8*sxx - sx*sx);
+        std::printf("%s: fixed %.1f us + %.1f us per expert\n", pass == 0 ? "graph" : "lean ", (sy - slope*sx)/8, slope);
+    }
+}
+
+int main(int argc, char ** argv) {
+    std::setvbuf(stdout, nullptr, _IONBF, 0);
+    ggml_cpu_init();
+    ggml_backend_t cpu = ggml_backend_cpu_init();
+    if (cpu == nullptr) {
+        std::printf("no CPU backend\n");
+        return 1;
+    }
+
+    if (argc > 1 && (std::string(argv[1]) == "--bench-pf" || std::string(argv[1]) == "--bench")) {
+        const bool pf = std::string(argv[1]) == "--bench-pf";
+        std::vector<int> cpus; // optional: comma separated logical CPUs, the last one is the calling thread's
+        if (argc > 3) {
+            std::string s = argv[3];
+            size_t pos = 0;
+            while (pos < s.size()) {
+                size_t nx = s.find(',', pos);
+                if (nx == std::string::npos) { nx = s.size(); }
+                cpus.push_back(std::atoi(s.substr(pos, nx - pos).c_str()));
+                pos = nx + 1;
+            }
+        }
+        if (pf) {
+            bench_pf(cpu, argc > 2 ? std::atoi(argv[2]) : 400, cpus);
+        } else {
+            bench(cpu, argc > 2 ? std::atoi(argv[2]) : 1500, cpus);
+        }
+        ggml_backend_free(cpu);
+        return 0;
+    }
+
+    const int n_embd = 2048, n_ff = 512, n_expert = 10;
+    const type_pair pairs[] = {
+        { GGML_TYPE_Q4_K,   GGML_TYPE_Q4_K,   "q4_K/q4_K"      },
+        { GGML_TYPE_Q4_K,   GGML_TYPE_Q6_K,   "q4_K/q6_K"      },
+        { GGML_TYPE_Q5_K,   GGML_TYPE_Q5_K,   "q5_K/q5_K"      },
+        { GGML_TYPE_Q8_0,   GGML_TYPE_Q8_0,   "q8_0/q8_0"      },
+        { GGML_TYPE_Q4_0,   GGML_TYPE_Q4_0,   "q4_0/q4_0"      },
+        { GGML_TYPE_Q5_1,   GGML_TYPE_Q5_0,   "q5_1/q5_0"      },
+        { GGML_TYPE_Q2_K,   GGML_TYPE_Q3_K,   "q2_K/q3_K"      },
+        { GGML_TYPE_IQ4_XS, GGML_TYPE_IQ4_NL, "iq4_xs/iq4_nl"  },
+        { GGML_TYPE_MXFP4,  GGML_TYPE_MXFP4,  "mxfp4/mxfp4"    },
+        { GGML_TYPE_F16,    GGML_TYPE_F16,    "f16/f16"        },
+        { GGML_TYPE_BF16,   GGML_TYPE_BF16,   "bf16/bf16"      },
+        { GGML_TYPE_F32,    GGML_TYPE_F32,    "f32/f32"        },
+    };
+    for (const type_pair & tp : pairs) {
+        check_pair(cpu, tp, n_embd, n_ff, n_expert);
+    }
+
+    // an idle team parks: after the last request the workers spin for the idle window (4 ms here) and then sleep, so a generation that has ended does not leave 8 cores spinning;
+    // the first request after a park wakes them and still gives the same bits
+    {
+        layer_weights lw;
+        if (make_layer(lw, cpu, GGML_TYPE_Q4_K, GGML_TYPE_Q4_K, 512, 256, 6, false, 9u)) {
+            const moe_lean::layer_banks lb = banks_of(lw);
+            moe_lean::team team(8, 512, 256, 0, nullptr, 4000);
+            std::mt19937 rng(31u);
+            std::normal_distribution<float> nd(0.0f, 1.0f);
+            std::vector<float> x(512), y0(512), y1(512);
+            for (auto & v : x) { v = nd(rng); }
+            const int32_t ids[3] = { 4, 1, 5 };
+            const float   w[3]   = { 0.5f, 0.3f, 0.2f };
+            moe_lean::job j;
+            j.lb = &lb; j.m = 3; j.ids = ids; j.w = w; j.x = x.data(); j.y = y0.data();
+            for (int i = 0; i < 20; ++i) { team.run(j); }
+            std::this_thread::sleep_for(std::chrono::milliseconds(100));      // let the workers reach their park
+            const double c0 = process_cpu_seconds();
+            std::this_thread::sleep_for(std::chrono::milliseconds(1000));
+            const double used = process_cpu_seconds() - c0;
+            CHECK(used < 0.5, "an idle 8-thread team used %.3f CPU-s in 1 s (workers did not park)", used);
+            std::printf("idle team: %.3f CPU-s over 1 s (8 threads, parked)\n", used);
+            // the stall diagnostic: with a zero threshold every request is described; the text names the stages and a CPU
+            int         n_stall = 0;
+            std::string last_stall;
+            team.set_stall_logger(0.0, [&](const char * s) { ++n_stall; last_stall = s; });
+            j.y = y1.data();
+            const auto t0 = std::chrono::steady_clock::now();
+            team.run(j);
+            const double wake_us = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - t0).count();
+            std::printf("first request after the park: %.0f us\n", wake_us);
+            CHECK(memcmp(y0.data(), y1.data(), 512*sizeof(float)) == 0, "the request after a park gave different bits");
+            CHECK(n_stall == 1 && last_stall.find("stage A") != std::string::npos && last_stall.find("stage D") != std::string::npos && last_stall.find("job pickup") != std::string::npos,
+                  "the stall logger did not describe the request (%d calls): %s", n_stall, last_stall.c_str());
+            std::printf("stall logger sample: %s\n", last_stall.c_str());
+        }
+    }
+
+    check_post_stage(cpu);
+
+    // layers the lean leg must refuse (the engine then keeps the graph for them)
+    {
+        layer_weights lw;
+        if (make_layer(lw, cpu, GGML_TYPE_Q4_K, GGML_TYPE_Q4_K, 512, 256, 4, false, 5u)) {
+            moe_lean::layer_banks lb = banks_of(lw);
+            CHECK(moe_lean::supported(lb), "a plain q4_K layer must be taken");
+            moe_lean::layer_banks bad = lb;
+            bad.gate.type = GGML_TYPE_Q5_K;                 // up and gate of different types
+            CHECK(!moe_lean::supported(bad), "up and gate of different types must be refused");
+            bad = lb;
+            bad.down.k = lb.down.k + 1;                     // down input width not the up output width
+            CHECK(!moe_lean::supported(bad), "a down bank that does not match the up bank must be refused");
+            bad = lb;
+            bad.up.k = 300; bad.gate.k = 300;               // not a multiple of the q8_K block
+            CHECK(!moe_lean::supported(bad), "a row length that is not a block multiple must be refused");
+        }
+    }
+
+    std::printf("test-moe-lean-expert: %d checks, %d failures\n", n_checks, n_failures);
+    ggml_backend_free(cpu);
+    return n_failures == 0 ? 0 : 1;
+}
diff --git a/tools/layer-streaming/tests/top2-exact-test.cpp b/tools/layer-streaming/tests/top2-exact-test.cpp
new file mode 100644
index 000000000..9a15abd1d
--- /dev/null
+++ b/tools/layer-streaming/tests/top2-exact-test.cpp
@@ -0,0 +1,71 @@
+// Host-only exactness test + timing of ls_top2_exact against the scalar loop.
+#include "../top2-exact.h"
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <random>
+#include <vector>
+
+int main() {
+    std::mt19937_64 rng(12345);
+    long long checked = 0, bad = 0;
+    // 1) exactness on many small / medium arrays with heavy ties, -inf, and positions of the maximum anywhere
+    for (int trial = 0; trial < 300000; ++trial) {
+        const int n = 1 + (int) (rng() % (trial % 7 == 0 ? 4000 : 200));
+        std::vector<float> x(n);
+        const int levels = 1 + (int) (rng() % 12);
+        for (int i = 0; i < n; ++i) {
+            const int r = (int) (rng() % (levels + 1));
+            x[i] = (float) r - 3.0f;
+            if (rng() % 97 == 0) { x[i] = -INFINITY; }
+        }
+        if (rng() % 5 == 0 && n > 2) { x[rng() % n] = 100.0f + (float) (rng() % 3); }   // a unique-ish tall peak somewhere
+        const ls_top2 a = ls_top2_scalar(x.data(), n);
+        const ls_top2 b = ls_top2_exact(x.data(), n);
+        ++checked;
+        if (a.best != b.best || a.second != b.second || a.best_val != b.best_val || a.second_val != b.second_val) {
+            if (++bad <= 5) {
+                printf("MISMATCH n=%d scalar (%d %.1f | %d %.1f) exact (%d %.1f | %d %.1f)\n", n, a.best, a.best_val, a.second, a.second_val, b.best, b.best_val, b.second, b.second_val);
+            }
+        }
+    }
+    // 2) a NaN anywhere must fall back and still agree
+    for (int trial = 0; trial < 2000; ++trial) {
+        const int n = 64 + (int) (rng() % 1000);
+        std::vector<float> x(n);
+        for (int i = 0; i < n; ++i) { x[i] = (float) (rng() % 10); }
+        x[rng() % n] = NAN;
+        const ls_top2 a = ls_top2_scalar(x.data(), n);
+        const ls_top2 b = ls_top2_exact(x.data(), n);
+        ++checked;
+        if (a.best != b.best || a.second != b.second) { ++bad; }
+    }
+    // 3) vocabulary-sized rows with realistic (non-tied) logits and a few exact ties at the top
+    const int NV = 248320;
+    std::vector<float> row(NV);
+    std::normal_distribution<float> nd(0.0f, 2.0f);
+    for (int trial = 0; trial < 200; ++trial) {
+        for (int i = 0; i < NV; ++i) { row[i] = nd(rng); }
+        row[rng() % NV] = 30.0f; if (trial % 3 == 0) { row[rng() % NV] = 30.0f; }
+        const ls_top2 a = ls_top2_scalar(row.data(), NV);
+        const ls_top2 b = ls_top2_exact(row.data(), NV);
+        ++checked;
+        if (a.best != b.best || a.second != b.second || a.best_val != b.best_val || a.second_val != b.second_val) { ++bad; }
+    }
+    printf("checked %lld rows, mismatches %lld, avx2 %d\n", checked, bad, (int) ls_cpu_has_avx2());
+    // timing on a vocabulary-sized row (result sink keeps the calls alive)
+    for (int i = 0; i < NV; ++i) { row[i] = nd(rng); }
+    int sink = 0;
+    const int reps = 2000;
+    auto t0 = std::chrono::steady_clock::now();
+    for (int r = 0; r < reps; ++r) { row[r % NV] += 0.001f; sink += ls_top2_scalar(row.data(), NV).second; }
+    auto t1 = std::chrono::steady_clock::now();
+    for (int r = 0; r < reps; ++r) { row[r % NV] += 0.001f; sink += ls_top2_exact(row.data(), NV).second; }
+    auto t2 = std::chrono::steady_clock::now();
+    // the old path also copied the row into a fresh std::vector each step
+    for (int r = 0; r < reps; ++r) { std::vector<float> c(row.data(), row.data() + NV); sink += ls_top2_scalar(c.data(), NV).second; }
+    auto t3 = std::chrono::steady_clock::now();
+    auto us = [](auto a, auto b) { return std::chrono::duration<double, std::micro>(b - a).count() / 2000.0; };
+    printf("per row: scalar %.1f us | exact vectorised %.1f us | copy into a fresh vector + scalar (the old path) %.1f us   (sink %d)\n", us(t0, t1), us(t1, t2), us(t2, t3), sink);
+    return bad == 0 ? 0 : 1;
+}
diff --git a/tools/layer-streaming/top2-exact.h b/tools/layer-streaming/top2-exact.h
new file mode 100644
index 000000000..3def6a0e7
--- /dev/null
+++ b/tools/layer-streaming/top2-exact.h
@@ -0,0 +1,148 @@
+// Exact greedy top-2 over a logits row, vectorised (AVX2 when the CPU has it), with the SAME result as the scalar loop the runner has always used:
+//
+//     best = 0; best_val = x[0]; second_val = -INF; second_tok = 0;
+//     for (v = 1; v < n; ++v) {
+//         if (x[v] > best_val)        { second_val = best_val; second_tok = best; best_val = x[v]; best = v; }
+//         else if (x[v] > second_val) { second_val = x[v];     second_tok = v; }
+//     }
+//
+// i.e. best = the FIRST index of the maximum; second = the maximum of all the other elements, taking the earliest index among equals (an element equal to the maximum, found later,
+// is the second). NaN anywhere, or a maximum of -INF, falls back to the scalar loop, so the result is identical in every case. Header-only, no dependencies.
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+
+#if defined(_MSC_VER) || defined(__x86_64__)
+#include <immintrin.h>
+#endif
+#if defined(_MSC_VER)
+#include <intrin.h>
+#endif
+
+struct ls_top2 {
+    int   best;
+    float best_val;
+    int   second;
+    float second_val;
+};
+
+static inline ls_top2 ls_top2_scalar(const float * x, int n) {
+    ls_top2 r;
+    r.best       = 0;
+    r.best_val   = x[0];
+    r.second_val = -INFINITY;
+    r.second     = 0;
+    for (int v = 1; v < n; ++v) {
+        if (x[v] > r.best_val) {
+            r.second_val = r.best_val;
+            r.second     = r.best;
+            r.best_val   = x[v];
+            r.best       = v;
+        } else if (x[v] > r.second_val) {
+            r.second_val = x[v];
+            r.second     = v;
+        }
+    }
+    return r;
+}
+
+static inline bool ls_cpu_has_avx2() {
+#if defined(_MSC_VER)
+    static const bool has = [] {
+        int r[4];
+        __cpuid(r, 0);
+        if (r[0] < 7) { return false; }
+        __cpuid(r, 1);
+        const bool osxsave = (r[2] & (1 << 27)) != 0;
+        const bool avx     = (r[2] & (1 << 28)) != 0;
+        if (!osxsave || !avx) { return false; }
+        if ((_xgetbv(0) & 6) != 6) { return false; }   // OS saves XMM + YMM state
+        __cpuidex(r, 7, 0);
+        return (r[1] & (1 << 5)) != 0;
+    }();
+    return has;
+#else
+    return false;
+#endif
+}
+
+#if defined(_MSC_VER)
+// max over [a, b) and whether any element is NaN
+static inline float ls_max_avx2(const float * x, int a, int b, bool * has_nan) {
+    __m256 m   = _mm256_set1_ps(-INFINITY);
+    __m256 nan = _mm256_setzero_ps();
+    int i = a;
+    for (; i + 8 <= b; i += 8) {
+        const __m256 v = _mm256_loadu_ps(x + i);
+        m   = _mm256_max_ps(m, v);
+        nan = _mm256_or_ps(nan, _mm256_cmp_ps(v, v, _CMP_UNORD_Q));
+    }
+    float lanes[8];
+    _mm256_storeu_ps(lanes, m);
+    float r = lanes[0];
+    for (int k = 1; k < 8; ++k) { r = lanes[k] > r ? lanes[k] : r; }
+    bool n_ = _mm256_movemask_ps(nan) != 0;
+    for (; i < b; ++i) {
+        n_ = n_ || (x[i] != x[i]);
+        r  = x[i] > r ? x[i] : r;
+    }
+    *has_nan = n_;
+    return r;
+}
+#endif
+
+static inline ls_top2 ls_top2_exact(const float * x, int n) {
+#if defined(_MSC_VER)
+    if (n >= 64 && ls_cpu_has_avx2()) {
+        bool nan = false;
+        const float M = ls_max_avx2(x, 0, n, &nan);
+        if (!nan && M > -INFINITY) {
+            // pass 2: the first two indices holding M, and the maximum of everything below M
+            int   first = -1, second_eq = -1;
+            const __m256 vM = _mm256_set1_ps(M);
+            __m256 below = _mm256_set1_ps(-INFINITY);
+            int i = 0;
+            for (; i + 8 <= n && second_eq < 0; i += 8) {
+                const __m256 v  = _mm256_loadu_ps(x + i);
+                const int    eq = _mm256_movemask_ps(_mm256_cmp_ps(v, vM, _CMP_EQ_OQ));
+                if (eq != 0) {
+                    for (int k = 0; k < 8; ++k) {
+                        if (eq & (1 << k)) {
+                            if (first < 0) { first = i + k; } else if (second_eq < 0) { second_eq = i + k; }
+                        }
+                    }
+                }
+                below = _mm256_max_ps(below, _mm256_blendv_ps(_mm256_set1_ps(-INFINITY), v, _mm256_cmp_ps(v, vM, _CMP_LT_OQ)));
+            }
+            float lanes[8];
+            _mm256_storeu_ps(lanes, below);
+            float below_max = lanes[0];
+            for (int k = 1; k < 8; ++k) { below_max = lanes[k] > below_max ? lanes[k] : below_max; }
+            // a second element equal to M ends the search early: it is the runner-up (value M, earliest index after the first), nothing can beat it
+            if (second_eq >= 0) {
+                return ls_top2{ first, M, second_eq, M };
+            }
+            for (; i < n; ++i) {
+                if (x[i] == M) {
+                    if (first < 0) { first = i; } else if (second_eq < 0) { second_eq = i; }
+                } else if (x[i] > below_max) {
+                    below_max = x[i];
+                }
+            }
+            if (second_eq >= 0) {
+                return ls_top2{ first, M, second_eq, M };
+            }
+            // unique maximum: the runner-up is the largest remaining value, at its earliest index
+            int sidx = -1;
+            for (int j = 0; j < n; ++j) {
+                if (j != first && x[j] == below_max) { sidx = j; break; }
+            }
+            if (sidx >= 0 && first >= 0) {
+                return ls_top2{ first, M, sidx, below_max };
+            }
+        }
+    }
+#endif
+    return ls_top2_scalar(x, n);
+}
