# Local environment files
.env
.env.*
!.env.example

# VS Code: retain shareable workspace configuration when intentionally added
/.vscode/*
!/.vscode/extensions.json
!/.vscode/launch.json
!/.vscode/settings.json
!/.vscode/tasks.json

# lean-ctx workspace settings: /.lean-ctx.toml is shared; setup backups stay local
/.lean-ctx*.bak*

# Operating-system files
.DS_Store
Thumbs.db
desktop.ini

# Freebuff session worktrees (tool-managed; each carries its own repo state)
/.freebuff/worktrees/
